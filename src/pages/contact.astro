---
import BaseLayout from "../components/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const interests = [
  {
    id: "certificate",
    label: "Executive Certificate",
    hint: "Apply or request a program brief.",
  },
  {
    id: "organizations",
    label: "For Organizations",
    hint: "Scope an engagement, cohort or rollout.",
  },
  {
    id: "diagnostic",
    label: "Alignment Diagnostic",
    hint: "Run the diagnostic in your organization.",
  },
  {
    id: "research",
    label: "Research Collaboration",
    hint: "Discuss expert review, pilots or academic work.",
  },
  {
    id: "other",
    label: "Something Else",
    hint: "A general enquiry or a conversation.",
  },
];
---

<BaseLayout
  title="Contact RAPL™ | Leadership Enquiries & Engagements"
  description="Talk to RAPL™ Leadership about the Executive Certificate, organizational engagements, the Alignment Diagnostic or research. We reply within two business days."
>
  <!-- ==================== 1. HERO (Figma Node 6380:10224) ==================== -->
  <section class="page-hero page-hero--contact">
    <div class="site-shell">
      <div class="contact-hero-layout reveal-on-scroll">
        <div class="contact-hero-spacer" aria-hidden="true"></div>
        <div class="contact-hero-content">
          <div class="eyebrow contact-hero-eyebrow">CONTACT</div>
          <h1 class="contact-hero-title">
            Talk to RAPL™ Leadership.
          </h1>
          <p class="contact-hero-lede">
            Choose the conversation that fits what you are trying to do. We respond to every enquiry within two business days.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. MAIN DISCUSSION & FORM (Figma Node 6381:10315) ==================== -->
  <section class="section section--contact-main">
    <div class="site-shell">
      <div class="contact-main-header reveal-on-scroll">
        <h2 class="contact-main-title">
          What would you like to discuss?
        </h2>
        <p class="contact-main-subtitle">
          Choose the conversation that matches the work you are trying to do. We use this to route the enquiry to the right person and to send you the most relevant follow-up.
        </p>
      </div>

      <div class="contact-split-grid reveal-on-scroll">
        <!-- Left: Option Cards -->
        <div class="contact-topics-stack" role="radiogroup" aria-label="Conversation Topics">
          {interests.map((item, idx) => (
            <button
              type="button"
              class={`contact-topic-card ${idx === 0 ? "is-active" : ""}`}
              data-topic-id={item.id}
              data-topic-label={item.label}
              role="radio"
              aria-checked={idx === 0 ? "true" : "false"}
            >
              <h3 class="contact-topic-title">{item.label}</h3>
              <p class="contact-topic-hint">{item.hint}</p>
            </button>
          ))}
        </div>

        <!-- Right: Message Form Card -->
        <div>
          <div class="contact-form-card">
            <div class="contact-form-head">
              <h3 class="contact-form-title">Send a message</h3>
              <p class="contact-form-desc">Tell us a little about you and the work.</p>
            </div>

            <form class="contact-form-grid" id="contact-form" onsubmit="event.preventDefault(); document.getElementById('contact-form').hidden = true; document.getElementById('contact-thanks').hidden = false;">
              <div class="contact-form-row">
                <div class="contact-form-field">
                  <label for="contact-name">Full Name:</label>
                  <input id="contact-name" name="name" type="text" placeholder="Your name" required />
                </div>
                <div class="contact-form-field">
                  <label for="contact-email">Work email:</label>
                  <input id="contact-email" name="email" type="email" placeholder="name@organization.com" required />
                </div>
              </div>

              <div class="contact-form-row">
                <div class="contact-form-field">
                  <label for="contact-org">Organization:</label>
                  <input id="contact-org" name="organization" type="text" placeholder="Organization name" />
                </div>
                <div class="contact-form-field">
                  <label for="contact-role">Your Role:</label>
                  <input id="contact-role" name="role" type="text" placeholder="e.g. CXO, Director, Sponsor" />
                </div>
              </div>

              <div class="contact-form-field">
                <label for="contact-thread">Conversation thread:</label>
                <select id="contact-thread" name="thread">
                  {interests.map((item) => (
                    <option value={item.id}>{item.label}</option>
                  ))}
                </select>
              </div>

              <div class="contact-form-field">
                <label for="contact-message">Tell us what you are trying to do</label>
                <textarea id="contact-message" name="message" rows="4" placeholder="Briefly describe what you are looking to achieve, the seats involved, or timeline..."></textarea>
              </div>

              <div class="contact-form-footer">
                <p class="contact-privacy-note">
                  We use your details only to respond to your enquiry. No marketing list. No sharing.
                </p>
                <button type="submit" class="contact-submit-btn">
                  Send message <span aria-hidden="true">→</span>
                </button>
              </div>
            </form>

            <div id="contact-thanks" hidden style="text-align: center; padding: 2.5rem 1rem;">
              <h3 style="font-size: 1.6rem; color: #3C3B3B; font-weight: 700; margin-bottom: 0.75rem;">Thank you. We have your message.</h3>
              <p style="color: #4C4747; font-family: var(--font-sans, 'Inria Sans', sans-serif); font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.75rem; max-width: 50ch; margin-inline: auto;">
                We respond to every enquiry within two business days. If your enquiry is time-sensitive, reach out directly at the address below.
              </p>
              <a class="contact-submit-btn" href="mailto:leadership@raplleadership.com" style="text-decoration: none;">leadership@raplleadership.com</a>
            </div>
          </div>

          <!-- Bottom direct contact info -->
          <div class="contact-info-cards">
            <div class="contact-info-card">
              <div class="contact-info-label">Direct email</div>
              <a href="mailto:leadership@raplleadership.com" class="contact-info-val">leadership@raplleadership.com</a>
            </div>
            <div class="contact-info-card">
              <div class="contact-info-label">Delivered by</div>
              <a href="https://snsccs.com/" target="_blank" rel="noreferrer" class="contact-info-val">SnS Coaching and Consulting Services</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. BEFORE YOU WRITE (CTA) ==================== -->
  <CTA
    eyebrow="Before you write"
    title="Some questions are answered in the framework."
    description="If you are new to RAPL™, the framework page is the fastest way to understand the model. The diagnostic is the fastest way to see whether the work is relevant to you."
    primary={{ label: "Read the framework", href: "/framework" }}
    secondary={{ label: "About RAPL™", href: "/about" }}
  />
</BaseLayout>

<script>
  // Dynamic sync between Option Cards and Conversation Thread select
  document.addEventListener("DOMContentLoaded", () => {
    const topicCards = document.querySelectorAll<HTMLButtonElement>(".contact-topic-card");
    const threadSelect = document.getElementById("contact-thread") as HTMLSelectElement | null;

    topicCards.forEach((card) => {
      card.addEventListener("click", () => {
        topicCards.forEach((c) => {
          c.classList.remove("is-active");
          c.setAttribute("aria-checked", "false");
        });
        card.classList.add("is-active");
        card.setAttribute("aria-checked", "true");

        const topicId = card.getAttribute("data-topic-id");
        if (threadSelect && topicId) {
          threadSelect.value = topicId;
        }
      });
    });

    if (threadSelect) {
      threadSelect.addEventListener("change", () => {
        const val = threadSelect.value;
        topicCards.forEach((card) => {
          const match = card.getAttribute("data-topic-id") === val;
          card.classList.toggle("is-active", match);
          card.setAttribute("aria-checked", match ? "true" : "false");
        });
      });
    }
  });
</script>
