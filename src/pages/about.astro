---
import BaseLayout from "../components/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const domainsRow1 = [
  "Business analysis",
  "Strategy",
  "Portfolio and program leadership",
  "Delivery sponsorship",
  "Risk",
];

const domainsRow2 = [
  "Stakeholder alignment",
  "Execution-office governance",
  "AI",
  "Change and adoption",
  "Benefits sustainment",
];

const principles = [
  {
    num: "01",
    title: "Applied",
    desc: "Capability must change decisions and behaviour in live work — not just assessment scores.",
  },
  {
    num: "02",
    title: "Accountable",
    desc: "Decision rights, risk ownership, adoption, benefits and consequences remain visible, the standard the Leadership Capability Alignment Diagnostic is built to measure.",
  },
  {
    num: "03",
    title: "Role-agnostic",
    desc: "Capability follows the work, not the job title — the depth required varies by seat and consequence.",
  },
  {
    num: "04",
    title: "Refreshable",
    desc: "A capability system that can be assessed, developed, applied, evidenced and refreshed over time.",
  },
  {
    num: "05",
    title: "Testable",
    desc: "The framework is offered for expert review, role-demand research, organizational testing and refinement — examined transparently in the research agenda.",
  },
];
---

<BaseLayout
  title="About RAPL™"
  description="A leadership framework for the work leaders are already expected to govern. Created by Samia Waqar and delivered through SnS Coaching and Consulting Services."
>
  <!-- ==================== 1. HERO (Figma Node 6197:10350) ==================== -->
  <section class="page-hero page-hero--about">
    <div class="site-shell">
      <div class="about-hero-content reveal-on-scroll">
        <div class="eyebrow about-hero-eyebrow">ABOUT RAPL™</div>
        <h1 class="about-hero-title">
          A leadership framework for the work leaders are already expected to govern.
        </h1>
        <p class="about-hero-lede">
          RAPL™ was developed to address a recurring organizational question: are
          leaders being prepared for the AI-enabled, project-shaped strategic work
          they are already accountable for?
        </p>
        <p class="about-hero-lede" style="margin-top: 1.25rem;">
          The <a href="/framework">RAPL™ Leadership Framework</a> brings together leadership acts drawn from
          business analysis, strategy, portfolio and program leadership, delivery
          sponsorship, risk, stakeholder alignment, execution-office governance, AI,
          change, adoption and benefits sustainment.
        </p>
        <div class="about-hero-buttons">
          <a class="about-btn-primary" href="/framework">
            Explore the framework→
          </a>
          <a class="about-btn-secondary" href="/research">
            Read the research
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. WHY RAPL™ EXISTS (Figma Node 6372:10097) ==================== -->
  <section class="section section--about-why">
    <div class="site-shell">
      <div class="about-why-grid reveal-on-scroll">
        <div>
          <div class="eyebrow about-why-eyebrow">WHY RAPL™ EXISTS</div>
          <h2 class="about-why-title">
            Strategic work has changed. Leadership development hasn't kept up.
          </h2>
        </div>
        <div>
          <p class="about-why-text">
            Organizations increasingly create value through temporary, cross-functional
            and change-intensive work. Senior leaders are expected to choose the right
            work, govern competing investment, sponsor delivery, lead through
            uncertainty, scale AI, build adoption and sustain benefits — often without
            a shared system for developing that judgment.
          </p>
          <p class="about-why-text">
            RAPL™ makes those responsibilities visible as one value cycle rather than a
            collection of disconnected specialisms — <a href="/">the same gap explored in more depth on the RAPL™ home page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. WHAT RAPL™ INTEGRATES (Figma Node 6374:10100) ==================== -->
  <section class="section section--about-integrates">
    <div class="site-shell">
      <div class="about-integrates-header reveal-on-scroll">
        <div class="eyebrow about-integrates-eyebrow">WHAT RAPL™ INTEGRATES</div>
        <h2 class="about-integrates-title">
          Ten established practice<br />domains — translated into<br /><span class="about-integrates-title-brown">one executive value cycle.</span>
        </h2>
      </div>

      <div class="about-domains-container reveal-on-scroll">
        <div class="about-domains-row">
          {domainsRow1.map((d) => (
            <span class="about-domain-pill">{d}</span>
          ))}
        </div>
        <div class="about-domains-row">
          {domainsRow2.map((d) => (
            <span class="about-domain-pill">{d}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 4. RAPL™ PRINCIPLES (Figma Node 6375:10127) ==================== -->
  <section class="section section--about-principles">
    <div class="site-shell">
      <div class="about-principles-header reveal-on-scroll">
        <div class="eyebrow about-principles-eyebrow">RAPL™ PRINCIPLES</div>
        <h2 class="about-principles-title">
          Five principles the<br />framework holds itself to.
        </h2>
        <p class="about-principles-lede">
          These are not aspirations. They are the test we apply when a new engagement, resource or capability claim enters the framework.
        </p>
      </div>

      <div class="about-principles-stack reveal-on-scroll">
        {principles.map((p, idx) => (
          <div class={`about-principle-card ${idx % 2 === 0 ? "about-principle-card--beige" : "about-principle-card--white"}`}>
            <div class="about-principle-num">{p.num}</div>
            <div class="about-principle-title">{p.title}</div>
            <div class="about-principle-desc">{p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 5. DELIVERED THROUGH (Figma Node 6375:10148) ==================== -->
  <section class="section section--about-delivered">
    <div class="site-shell">
      <div class="about-delivered-grid reveal-on-scroll">
        <div>
          <div class="eyebrow about-delivered-eyebrow">DELIVERED THROUGH</div>
          <h2 class="about-delivered-title">
            SnS Coaching and Consulting Services.
          </h2>
          <p class="about-delivered-lede">
            The <a href="/certificate">Executive Certificate</a> and
            <a href="/organizations">organizational RAPL™ engagements</a>
            are delivered through <a href="https://snsccs.com/" target="_blank" rel="noreferrer">SnS Coaching and Consulting Services</a>,
            scoped against the strategic work, the seats involved, and the system we
            need to influence.
          </p>
        </div>

        <div class="about-dark-card">
          <h3 class="about-dark-card-title">Three things to know</h3>
          <ul class="about-dark-card-list">
            <li>1. RAPL™ is created by Samia Waqar.</li>
            <li>2. Delivered through SnS Coaching and Consulting Services.</li>
            <li>3. Examined transparently in a published research agenda.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 5. ABOUT THE CREATOR (Figma Node 6377:10057) ==================== -->
  <section class="section section--about-creator">
    <div class="site-shell">
      <div class="about-creator-layout reveal-on-scroll">
        <!-- Left spacer for the photo of Samia Waqar in the background image -->
        <div class="about-creator-spacer" aria-hidden="true"></div>

        <!-- Right column with all text, CTAs and Quote card -->
        <div class="about-creator-content">
          <div class="eyebrow about-creator-eyebrow">ABOUT THE CREATER</div>
          <h2 class="about-creator-title">
            Samia Waqar
          </h2>
          <p class="about-creator-text">
            Samia Waqar is the creator of RAPL™ and the founder of SnS Coaching and
            Consulting Services. Her work sits at the intersection of leadership
            development, AI-enabled transformation and the discipline required to land
            strategic value in operations.
          </p>
          <p class="about-creator-text">
            She is also the author of <a href="https://samiawaqar.com/book" target="_blank" rel="noreferrer">The Leadership Economy</a> — the broader thinking behind RAPL™'s approach to leadership and value.
          </p>
          <div class="about-creator-buttons">
            <a class="about-btn-primary" href="https://samiawaqar.com/about" target="_blank" rel="noreferrer">
              About Samia Waqar ↗
            </a>
            <a class="about-btn-outline" href="/contact">
              Get in touch
            </a>
          </div>

          <div class="about-quote-card">
            <p class="about-quote-text">
              “Strategic work has changed faster than the leadership systems that
              prepare executives for it. RAPL™ exists to make that gap visible, and
              to give senior leaders a structured way to close it.”
            </p>
            <hr class="about-quote-divider" />
            <h4 class="about-quote-author">Samia Waqar</h4>
            <p class="about-quote-role">Creator, RAPL™</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 6. BEGIN / CTA BANNER (Figma Node 6377:10072) ==================== -->
  <CTA
    eyebrow="BEGIN"
    title="Explore the framework, discuss the Executive Certificate or begin an organizational diagnostic."
    primary={{ label: "Explore the framework→", href: "/framework" }}
    secondary={{ label: "Start the Diagnostic", href: "/assessment" }}
  />
</BaseLayout>
