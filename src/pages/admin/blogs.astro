    /* A class that sets `display` outranks the UA's `[hidden] { display: none }`,
       so this modal stayed mounted as an invisible, full-viewport, z-index 100
       overlay even while carrying the `hidden` attribute -- and swallowed every
       click on the page beneath it, including Login. Scoping the display rule to
       the open state keeps `hidden` authoritative. Same failure mode as the one
       fixed on the enroll-now cancelled notice in ca4dcf5. */
    .rapl-admin-modal[hidden] {
      display: none;
    }

    .rapl-admin-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 3rem 1rem;
      overflow-y: auto;
    }

    .rapl-admin-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 30, 49, 0.55);
    }

    .rapl-admin-modal-panel {
      position: relative;
      background: #fff;
      border-radius: 6px;
      max-width: 780px;
      width: 100%;
      padding: 1.75rem;
    }

    .rapl-admin-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .rapl-admin-modal-header button {
      background: none;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      line-height: 1;
    }

    .rapl-editor {
      border: 1px solid rgba(16, 32, 43, 0.2);
      border-radius: 4px;
      /* NOT `overflow: hidden`. That made this box the sticky containment
         context for the toolbar below, so the toolbar could only ever stick
         within the editor's own height — i.e. it scrolled away with the content
         and you had to scroll back up to reach H1/Bold. The rounded corners it
         was clipping are applied to the two children directly instead. */
    }

    /* Keeps the formatting controls reachable while writing a long post. The
       modal is the scroll container, so top:0 pins it to the modal's top edge. */
    .rapl-editor-toolbar {
      position: sticky;
      top: 0;
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      padding: 0.5rem;
      background: #f6f4f2;
      border-bottom: 1px solid rgba(16, 32, 43, 0.12);
      border-top-left-radius: 4px;
      border-top-right-radius: 4px;
    }

    .rapl-editor-area {
      border-bottom-left-radius: 4px;
      border-bottom-right-radius: 4px;
    }

    .rapl-editor-toolbar button {
      font: inherit;
      font-size: 0.8rem;
      padding: 0.3rem 0.55rem;
      border: 1px solid rgba(16, 32, 43, 0.18);
      border-radius: 3px;
      background: #fff;
      cursor: pointer;
    }

    .rapl-editor-docx-btn { font-weight: 700; }
