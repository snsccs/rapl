---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout
  title="Audience Poll | RAPL™ Leadership"
  description="Take the RAPL™ audience poll and see how other leaders responded."
>
  <!-- ==================== 1. HERO ==================== -->
  <section class="page-hero page-hero--poll">
    <div class="site-shell">
      <div class="poll-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436;">
          AUDIENCE POLL
        </div>
        <h1 class="poll-hero-title" id="poll-hero-title">
          Take the poll
        </h1>
        <p class="poll-hero-lede" id="poll-hero-lede">
          Answer a few quick questions — you can skip any of them.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== 2. POLL WIZARD ==================== -->
  <section class="section" style="background: #ffffff; padding-block: clamp(3rem, 6vw, 5rem);">
    <div class="site-shell" style="max-width: 100rem; margin-inline: auto;">
      <div class="poll-split-layout">
        <div class="contact-form-card reveal-on-scroll" id="poll-wizard-card">
          <p id="poll-loading" class="poll-loading">Loading poll…</p>
          <p id="poll-unavailable" class="poll-loading" hidden>This poll isn't available right now.</p>

          <div id="poll-wizard" hidden>
            <div class="poll-wizard-progress">
              <div class="poll-wizard-progress-track">
                <div class="poll-wizard-progress-fill" id="poll-progress-fill"></div>
              </div>
              <p class="poll-wizard-progress-text" id="poll-progress-text"></p>
            </div>

            <div id="poll-step-container" class="poll-step-container"></div>
            <p id="poll-step-error" class="poll-step-error" hidden></p>

            <div class="poll-wizard-nav">
              <button type="button" class="poll-nav-btn poll-nav-btn--ghost" id="poll-back-btn">
                Back
              </button>
              <button type="button" class="poll-nav-btn poll-nav-btn--ghost" id="poll-skip-btn">
                Skip
              </button>
              <button type="button" class="poll-nav-btn poll-nav-btn--primary" id="poll-next-btn">
                Next
              </button>
            </div>
          </div>

          <div id="poll-thanks" hidden style="text-align: center; padding: 2.5rem 1rem;">
            <h3 style="font-size: 1.6rem; color: #3C3B3B; font-weight: 700; margin-bottom: 0.75rem;">Thank you for taking the poll.</h3>
            <p style="color: #4C4747; font-family: var(--font-sans, 'Inria Sans', sans-serif); font-size: 1.1rem; line-height: 1.6;">
              Your response has been recorded as part of the group totals.
            </p>
          </div>

          <p id="poll-submit-error" hidden style="color: #781222; margin-top: 1rem; font-family: var(--font-sans, 'Inria Sans', sans-serif);"></p>
        </div>

        <div class="contact-form-card poll-results-panel" id="poll-results-panel" hidden>
          <div class="poll-results-panel-head">
            <div class="eyebrow" style="color: #755436;">LIVE RESULTS</div>
            <h3 class="poll-results-panel-title" id="poll-results-title">This question's results</h3>
            <p class="poll-results-panel-sub" id="poll-results-subtitle"></p>
          </div>
          <div id="poll-results-body"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface PollQuestion {
    key: string;
    label: string;
    type: "single" | "multi" | "scale" | "text";
    options?: string[];
    required?: boolean;
  }

  interface Poll {
    slug: string;
    title: string;
    description: string | null;
    status: string;
    collectContactInfo: boolean;
    questions: PollQuestion[];
  }

  interface PollResultsQuestion extends PollQuestion {
    counts?: Record<string, number>;
    percentages?: Record<string, number>;
    distribution?: Record<string, number>;
    average?: number | null;
    answeredCount: number;
  }

  interface PollResults {
    totalResponses: number;
    questions: PollResultsQuestion[];
  }

  type Step = { kind: "question"; question: PollQuestion } | { kind: "contact" };

  const API_BASE = "https://api.snsccs.com/api/rapl-audience-poll";

  const params = new URLSearchParams(window.location.search);
  const slugParam = params.get("poll");

  let poll: Poll | null = null;
  let steps: Step[] = [];
  let currentStep = 0;
  let latestResults: PollResults | null = null;
  const answers: Record<string, string | string[]> = {};
  const contact = { name: "", email: "", phone: "", job_title: "" };

  const loadingEl = document.getElementById("poll-loading");
  const unavailableEl = document.getElementById("poll-unavailable");
  const wizardEl = document.getElementById("poll-wizard");
  const progressFill = document.getElementById("poll-progress-fill") as HTMLDivElement | null;
  const progressText = document.getElementById("poll-progress-text");
  const stepContainer = document.getElementById("poll-step-container");
  const stepError = document.getElementById("poll-step-error");
  const backBtn = document.getElementById("poll-back-btn") as HTMLButtonElement | null;
  const skipBtn = document.getElementById("poll-skip-btn") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("poll-next-btn") as HTMLButtonElement | null;
  const thanksEl = document.getElementById("poll-thanks");
  const submitErrorEl = document.getElementById("poll-submit-error");
  const heroTitle = document.getElementById("poll-hero-title");
  const heroLede = document.getElementById("poll-hero-lede");
  const resultsPanelEl = document.getElementById("poll-results-panel");
  const resultsTitleEl = document.getElementById("poll-results-title");
  const resultsSubtitleEl = document.getElementById("poll-results-subtitle");
  const resultsBodyEl = document.getElementById("poll-results-body");

  const buildSteps = (loadedPoll: Poll): Step[] => {
    const questionSteps: Step[] = loadedPoll.questions.map((question) => ({ kind: "question", question }));
    return loadedPoll.collectContactInfo ? [...questionSteps, { kind: "contact" }] : questionSteps;
  };

  const questionStepCount = () => steps.filter((step) => step.kind === "question").length;

  const renderOptionsField = (question: PollQuestion): HTMLElement => {
    const wrap = document.createElement("div");

    if (question.type === "single" || question.type === "multi") {
      const optsWrap = document.createElement("div");
      optsWrap.className = "poll-options";
      const current = answers[question.key];
      (question.options || []).forEach((option, index) => {
        const optId = `${question.key}-${index}`;
        const optLabel = document.createElement("label");
        optLabel.className = "poll-option";
        optLabel.setAttribute("for", optId);

        const input = document.createElement("input");
        input.type = question.type === "single" ? "radio" : "checkbox";
        input.name = `answers.${question.key}`;
        input.id = optId;
        input.value = option;
        if (question.type === "single" && current === option) input.checked = true;
        if (question.type === "multi" && Array.isArray(current) && current.includes(option)) input.checked = true;

        optLabel.appendChild(input);
        optLabel.appendChild(document.createTextNode(option));
        optsWrap.appendChild(optLabel);
      });
      wrap.appendChild(optsWrap);
    } else if (question.type === "scale") {
      const scaleWrap = document.createElement("div");
      scaleWrap.className = "poll-scale";
      const current = answers[question.key];
      for (let i = 1; i <= 5; i += 1) {
        const optLabel = document.createElement("label");
        optLabel.className = "poll-scale-option";

        const input = document.createElement("input");
        input.type = "radio";
        input.name = `answers.${question.key}`;
        input.value = String(i);
        if (current === String(i)) input.checked = true;

        optLabel.appendChild(input);
        optLabel.appendChild(document.createTextNode(String(i)));
        scaleWrap.appendChild(optLabel);
      }
      wrap.appendChild(scaleWrap);
    } else {
      const textarea = document.createElement("textarea");
      textarea.name = `answers.${question.key}`;
      textarea.rows = 3;
      textarea.value = typeof answers[question.key] === "string" ? (answers[question.key] as string) : "";
      wrap.appendChild(textarea);
    }

    return wrap;
  };

  const renderQuestionStep = (question: PollQuestion) => {
    if (!stepContainer) return;
    stepContainer.innerHTML = "";

    const label = document.createElement("h3");
    label.className = "poll-step-question";
    label.textContent = question.label + (question.required ? " *" : "");
    stepContainer.appendChild(label);
    stepContainer.appendChild(renderOptionsField(question));
  };

  const renderContactStep = () => {
    if (!stepContainer) return;
    stepContainer.innerHTML = "";

    const intro = document.createElement("h3");
    intro.className = "poll-step-question";
    intro.textContent = "Optional — want us to follow up?";
    stepContainer.appendChild(intro);

    const fields: Array<{ id: string; name: keyof typeof contact; label: string; type: string }> = [
      { id: "poll-name", name: "name", label: "Name:", type: "text" },
      { id: "poll-email", name: "email", label: "Email:", type: "email" },
      { id: "poll-phone", name: "phone", label: "Contact Number:", type: "tel" },
      { id: "poll-job-title", name: "job_title", label: "Job Title:", type: "text" }
    ];

    fields.forEach((field) => {
      const row = document.createElement("div");
      row.className = "contact-form-field";
      const fieldLabel = document.createElement("label");
      fieldLabel.setAttribute("for", field.id);
      fieldLabel.textContent = field.label;
      const input = document.createElement("input");
      input.id = field.id;
      input.type = field.type;
      input.name = field.name;
      input.placeholder = "Optional";
      input.value = contact[field.name];
      row.appendChild(fieldLabel);
      row.appendChild(input);
      stepContainer.appendChild(row);
    });
  };

  const renderBar = (labelText: string, count: number, pct: number): HTMLElement => {
    const row = document.createElement("div");
    row.className = "poll-bar-row";

    const labelEl = document.createElement("div");
    labelEl.className = "poll-bar-label";
    labelEl.textContent = labelText;

    const track = document.createElement("div");
    track.className = "poll-bar-track";
    const fill = document.createElement("div");
    fill.className = "poll-bar-fill";
    fill.style.width = `${pct}%`;
    track.appendChild(fill);

    const figure = document.createElement("div");
    figure.className = "poll-bar-figure";
    figure.title = `${count} response${count === 1 ? "" : "s"}`;
    const pctEl = document.createElement("span");
    pctEl.className = "poll-bar-pct";
    pctEl.textContent = `${pct}%`;
    const countEl = document.createElement("span");
    countEl.className = "poll-bar-count";
    countEl.textContent = `· ${count}`;
    figure.appendChild(pctEl);
    figure.appendChild(countEl);

    row.appendChild(labelEl);
    row.appendChild(track);
    row.appendChild(figure);
    return row;
  };

  const renderResultsForStep = () => {
    if (!resultsBodyEl || !resultsSubtitleEl || !resultsTitleEl) return;
    const step = steps[currentStep];

    if (!step || step.kind !== "question") {
      resultsTitleEl.textContent = "Thanks for taking part";
      resultsSubtitleEl.textContent = latestResults
        ? `${latestResults.totalResponses} response${latestResults.totalResponses === 1 ? "" : "s"} so far`
        : "";
      resultsBodyEl.innerHTML = "";
      const p = document.createElement("p");
      p.className = "poll-loading";
      p.textContent = "Live results for each question show here as you go through the poll.";
      resultsBodyEl.appendChild(p);
      return;
    }

    const { key, label, type } = step.question;
    resultsTitleEl.textContent = label;
    const result = latestResults?.questions.find((q) => q.key === key);

    if (!result) {
      resultsSubtitleEl.textContent = "No responses yet";
      resultsBodyEl.innerHTML = "";
      return;
    }

    const total = latestResults?.totalResponses ?? 0;
    resultsSubtitleEl.textContent =
      result.answeredCount === total
        ? `${total} response${total === 1 ? "" : "s"}`
        : `${result.answeredCount} of ${total} respondents answered`;
    resultsBodyEl.innerHTML = "";

    if (type === "scale") {
      const avg = document.createElement("p");
      avg.className = "poll-result-average";
      avg.textContent = result.average != null ? `Average: ${result.average} / 5` : "No responses yet";
      resultsBodyEl.appendChild(avg);
      for (let i = 1; i <= 5; i += 1) {
        const count = result.distribution?.[i] || 0;
        const pct = result.answeredCount > 0 ? Math.round((count / result.answeredCount) * 1000) / 10 : 0;
        resultsBodyEl.appendChild(renderBar(String(i), count, pct));
      }
    } else if (type === "text") {
      const p = document.createElement("p");
      p.textContent = `${result.answeredCount} response${result.answeredCount === 1 ? "" : "s"} submitted so far.`;
      resultsBodyEl.appendChild(p);
    } else {
      (result.options || []).forEach((option) => {
        const count = result.counts?.[option] || 0;
        const pct = result.percentages?.[option] ?? 0;
        resultsBodyEl.appendChild(renderBar(option, count, pct));
      });
    }
  };

  const connectLiveResults = (slug: string) => {
    if (typeof EventSource === "undefined") return;

    const source = new EventSource(`${API_BASE}/${slug}/results/stream`);
    source.onmessage = (event) => {
      try {
        latestResults = JSON.parse(event.data) as PollResults;
        renderResultsForStep();
      } catch {
        // Ignore malformed events; the next push will self-correct.
      }
    };
  };

  // Belt-and-braces alongside the SSE push: browsers cap concurrent
  // HTTP/1.1 connections per origin at 6, so a visitor with several poll
  // tabs open can end up with a stream that's silently stuck. Re-fetch a
  // fresh snapshot whenever this tab regains focus so it can't stay stale
  // for longer than "until you look at it again".
  const refreshResultsSnapshot = async (slug: string) => {
    try {
      const res = await fetch(`${API_BASE}/${slug}/results`);
      const json = await res.json();
      if (res.ok && json.success) {
        latestResults = json.data as PollResults;
        renderResultsForStep();
      }
    } catch {
      // Leave whatever we already have on screen; the next SSE push or
      // focus event will try again.
    }
  };

  const updateNav = () => {
    if (!backBtn || !skipBtn || !nextBtn) return;
    const step = steps[currentStep];

    backBtn.disabled = currentStep === 0;

    const isRequiredQuestion = step.kind === "question" && Boolean(step.question.required);
    skipBtn.hidden = isRequiredQuestion;

    const isLastStep = currentStep === steps.length - 1;
    nextBtn.textContent = isLastStep ? "Submit" : "Next";
  };

  const renderStep = () => {
    stepError?.setAttribute("hidden", "true");
    const step = steps[currentStep];

    if (heroTitle && heroLede) {
      if (step.kind === "question") {
        const qIndex = steps.slice(0, currentStep + 1).filter((s) => s.kind === "question").length;
        heroLede.textContent = `Question ${qIndex} of ${questionStepCount()} — you can skip any question.`;
      } else {
        heroLede.textContent = "Just a couple more optional fields, then you're done.";
      }
    }

    if (progressFill) {
      const pct = Math.round(((currentStep + 1) / steps.length) * 100);
      progressFill.style.width = `${pct}%`;
    }
    if (progressText) {
      progressText.textContent = `Step ${currentStep + 1} of ${steps.length}`;
    }

    if (step.kind === "question") {
      renderQuestionStep(step.question);
    } else {
      renderContactStep();
    }

    updateNav();
    renderResultsForStep();
  };

  const collectCurrentStep = () => {
    const step = steps[currentStep];
    if (!stepContainer) return;

    if (step.kind === "question") {
      const { key, type } = step.question;
      if (type === "multi") {
        const checked = Array.from(stepContainer.querySelectorAll<HTMLInputElement>(`input[name="answers.${key}"]:checked`));
        const values = checked.map((input) => input.value);
        if (values.length) answers[key] = values;
        else delete answers[key];
      } else if (type === "text") {
        const textarea = stepContainer.querySelector<HTMLTextAreaElement>(`textarea[name="answers.${key}"]`);
        const value = textarea?.value.trim() || "";
        if (value) answers[key] = value;
        else delete answers[key];
      } else {
        const checked = stepContainer.querySelector<HTMLInputElement>(`input[name="answers.${key}"]:checked`);
        if (checked) answers[key] = checked.value;
        else delete answers[key];
      }
    } else {
      (Object.keys(contact) as Array<keyof typeof contact>).forEach((name) => {
        const input = stepContainer.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        contact[name] = input?.value.trim() || "";
      });
    }
  };

  const clearCurrentStepAnswer = () => {
    const step = steps[currentStep];
    if (step.kind === "question") {
      delete answers[step.question.key];
    } else {
      (Object.keys(contact) as Array<keyof typeof contact>).forEach((name) => {
        contact[name] = "";
      });
    }
  };

  const submitPoll = async () => {
    if (!poll || !nextBtn) return;

    nextBtn.disabled = true;
    if (backBtn) backBtn.disabled = true;
    if (skipBtn) skipBtn.disabled = true;
    submitErrorEl?.setAttribute("hidden", "true");

    const payload = {
      name: contact.name,
      email: contact.email,
      phone: contact.phone,
      job_title: contact.job_title,
      answers
    };

    try {
      const res = await fetch(`${API_BASE}/${poll.slug}/responses`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const json = await res.json();

      if (!res.ok || !json.success) {
        const message = json.errors?.[0]?.msg || json.message || "Something went wrong. Please try again.";
        throw new Error(message);
      }

      wizardEl?.setAttribute("hidden", "true");
      thanksEl?.removeAttribute("hidden");
    } catch (err) {
      if (submitErrorEl) {
        submitErrorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
        submitErrorEl.removeAttribute("hidden");
      }
      nextBtn.disabled = false;
      if (backBtn) backBtn.disabled = false;
      if (skipBtn) skipBtn.disabled = false;
    }
  };

  backBtn?.addEventListener("click", () => {
    if (currentStep === 0) return;
    collectCurrentStep();
    currentStep -= 1;
    renderStep();
  });

  skipBtn?.addEventListener("click", () => {
    clearCurrentStepAnswer();
    if (currentStep === steps.length - 1) {
      submitPoll();
      return;
    }
    currentStep += 1;
    renderStep();
  });

  nextBtn?.addEventListener("click", () => {
    collectCurrentStep();

    const step = steps[currentStep];
    if (step.kind === "question" && step.question.required && !answers[step.question.key]) {
      if (stepError) {
        stepError.textContent = "This question is required.";
        stepError.removeAttribute("hidden");
      }
      return;
    }

    if (currentStep === steps.length - 1) {
      submitPoll();
      return;
    }
    currentStep += 1;
    renderStep();
  });

  const loadPoll = async () => {
    try {
      const endpoint = slugParam ? `${API_BASE}/${encodeURIComponent(slugParam)}` : `${API_BASE}/active`;
      const res = await fetch(endpoint);
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || "Unable to load poll");

      poll = json.data as Poll;
      if (poll.status !== "active") throw new Error("This poll is not currently active");

      steps = buildSteps(poll);
      if (heroTitle) heroTitle.textContent = poll.title;

      loadingEl?.setAttribute("hidden", "true");
      wizardEl?.removeAttribute("hidden");
      resultsPanelEl?.removeAttribute("hidden");
      renderStep();
      connectLiveResults(poll.slug);

      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && poll) {
          refreshResultsSnapshot(poll.slug);
        }
      });
    } catch (err) {
      loadingEl?.setAttribute("hidden", "true");
      unavailableEl?.removeAttribute("hidden");
    }
  };

  loadPoll();
</script>
