---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout
  title="Audience Poll | RAPL™ Leadership"
  description="Take the RAPL™ audience poll on the Leadership Capability Gap and see how other leaders responded."
>
  <!-- ==================== 1. HERO ==================== -->
  <section class="page-hero page-hero--poll">
    <div class="site-shell">
      <div class="poll-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436;">
          AUDIENCE POLL
        </div>
        <h1 class="poll-hero-title">
          The Leadership Capability Gap: where does your organization stand?
        </h1>
        <p class="poll-hero-lede">
          Answer a few quick questions, then see how other leaders responded. The fields below the questions are optional and only used if you want us to follow up.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== 2. POLL FORM + RESULTS ==================== -->
  <section class="section" style="background: #ffffff; padding-block: clamp(3rem, 6vw, 5rem);">
    <div class="site-shell">
      <div class="split-layout reveal-on-scroll">
        <!-- Left: Poll form -->
        <div class="contact-form-card" id="poll-form-card">
          <div class="contact-form-head">
            <h3 class="contact-form-title">Take the poll</h3>
            <p class="contact-form-desc">Your responses help us understand how leaders see this gap.</p>
          </div>

          <form class="contact-form-grid" id="poll-form">
            <div id="poll-questions" class="poll-questions">
              <p class="poll-loading">Loading poll…</p>
            </div>

            <div class="contact-form-row">
              <div class="contact-form-field">
                <label for="poll-name">Name:</label>
                <input id="poll-name" name="name" type="text" placeholder="Optional" />
              </div>
              <div class="contact-form-field">
                <label for="poll-email">Email:</label>
                <input id="poll-email" name="email" type="email" placeholder="Optional" />
              </div>
            </div>
            <div class="contact-form-row">
              <div class="contact-form-field">
                <label for="poll-phone">Contact Number:</label>
                <input id="poll-phone" name="phone" type="tel" placeholder="Optional" />
              </div>
              <div class="contact-form-field">
                <label for="poll-job-title">Job Title:</label>
                <input id="poll-job-title" name="job_title" type="text" placeholder="Optional" />
              </div>
            </div>

            <div class="contact-form-footer">
              <p class="contact-privacy-note">
                We never share individual responses — only aggregate poll results.
              </p>
              <button type="submit" class="contact-submit-btn" id="poll-submit-btn">
                Submit response <span aria-hidden="true">→</span>
              </button>
            </div>
          </form>

          <div id="poll-thanks" hidden style="text-align: center; padding: 2.5rem 1rem;">
            <h3 style="font-size: 1.6rem; color: #3C3B3B; font-weight: 700; margin-bottom: 0.75rem;">Thank you for taking the poll.</h3>
            <p style="color: #4C4747; font-family: var(--font-sans, 'Inria Sans', sans-serif); font-size: 1.1rem; line-height: 1.6;">
              Click "View Poll Results" on the right to see how other leaders responded.
            </p>
          </div>

          <p id="poll-error" hidden style="color: #781222; margin-top: 1rem; font-family: var(--font-sans, 'Inria Sans', sans-serif);"></p>
        </div>

        <!-- Right: Results panel -->
        <div class="poll-results-panel card card--feature">
          <h3 class="contact-form-title" style="margin-bottom: 0.5rem;">See how others answered</h3>
          <p class="contact-form-desc" style="margin-bottom: 1.5rem;">Aggregate results from everyone who has taken this poll so far.</p>
          <button type="button" class="button primary" id="poll-view-results-btn">
            View Poll Results
          </button>
          <div id="poll-results" hidden style="margin-top: 1.5rem;">
            <p class="poll-total-responses"></p>
            <div id="poll-results-charts"></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface PollQuestion {
    key: string;
    label: string;
    type: "single" | "multi" | "scale" | "text";
    options?: string[];
    required?: boolean;
  }

  interface PollResultsQuestion extends PollQuestion {
    counts?: Record<string, number>;
    distribution?: Record<string, number>;
    average?: number | null;
    answeredCount?: number;
  }

  const API_BASE = "https://api.snsccs.com/api/rapl-audience-poll";

  let activeSlug: string | null = null;
  let activeQuestions: PollQuestion[] = [];

  const questionsContainer = document.getElementById("poll-questions");
  const form = document.getElementById("poll-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("poll-submit-btn") as HTMLButtonElement | null;
  const thanksEl = document.getElementById("poll-thanks");
  const errorEl = document.getElementById("poll-error");
  const resultsBtn = document.getElementById("poll-view-results-btn") as HTMLButtonElement | null;
  const resultsPanel = document.getElementById("poll-results");
  const resultsCharts = document.getElementById("poll-results-charts");
  const totalResponsesEl = document.querySelector<HTMLParagraphElement>(".poll-total-responses");

  const renderQuestion = (question: PollQuestion): HTMLElement => {
    const wrap = document.createElement("div");
    wrap.className = "contact-form-field poll-question";

    const label = document.createElement("label");
    label.textContent = question.label + (question.required ? " *" : "");
    wrap.appendChild(label);

    if (question.type === "single" || question.type === "multi") {
      const optsWrap = document.createElement("div");
      optsWrap.className = "poll-options";
      (question.options || []).forEach((option, index) => {
        const optId = `${question.key}-${index}`;
        const optLabel = document.createElement("label");
        optLabel.className = "poll-option";
        optLabel.setAttribute("for", optId);

        const input = document.createElement("input");
        input.type = question.type === "single" ? "radio" : "checkbox";
        input.name = `answers.${question.key}`;
        input.id = optId;
        input.value = option;

        optLabel.appendChild(input);
        optLabel.appendChild(document.createTextNode(option));
        optsWrap.appendChild(optLabel);
      });
      wrap.appendChild(optsWrap);
    } else if (question.type === "scale") {
      const scaleWrap = document.createElement("div");
      scaleWrap.className = "poll-scale";
      for (let i = 1; i <= 5; i += 1) {
        const optLabel = document.createElement("label");
        optLabel.className = "poll-scale-option";

        const input = document.createElement("input");
        input.type = "radio";
        input.name = `answers.${question.key}`;
        input.value = String(i);

        optLabel.appendChild(input);
        optLabel.appendChild(document.createTextNode(String(i)));
        scaleWrap.appendChild(optLabel);
      }
      wrap.appendChild(scaleWrap);
    } else {
      const textarea = document.createElement("textarea");
      textarea.name = `answers.${question.key}`;
      textarea.rows = 3;
      wrap.appendChild(textarea);
    }

    return wrap;
  };

  const loadActivePoll = async () => {
    if (!questionsContainer) return;
    try {
      const res = await fetch(`${API_BASE}/active`);
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || "Unable to load poll");

      activeSlug = json.data.slug;
      activeQuestions = Array.isArray(json.data.questions) ? json.data.questions : [];

      questionsContainer.innerHTML = "";
      activeQuestions.forEach((question) => questionsContainer.appendChild(renderQuestion(question)));
    } catch (err) {
      questionsContainer.innerHTML = "";
      const message = document.createElement("p");
      message.className = "poll-loading";
      message.textContent = "This poll isn't available right now.";
      questionsContainer.appendChild(message);
    }
  };

  const collectAnswers = (formData: FormData): Record<string, string | string[]> => {
    const answers: Record<string, string | string[]> = {};
    activeQuestions.forEach((question) => {
      if (question.type === "multi") {
        const values = formData.getAll(`answers.${question.key}`).map(String);
        if (values.length) answers[question.key] = values;
      } else {
        const value = formData.get(`answers.${question.key}`);
        if (value !== null && String(value) !== "") answers[question.key] = String(value);
      }
    });
    return answers;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !activeSlug) return;

    errorEl?.setAttribute("hidden", "true");
    const formData = new FormData(form);

    const payload = {
      name: formData.get("name"),
      email: formData.get("email"),
      phone: formData.get("phone"),
      job_title: formData.get("job_title"),
      answers: collectAnswers(formData)
    };

    if (submitBtn) submitBtn.disabled = true;

    try {
      const res = await fetch(`${API_BASE}/${activeSlug}/responses`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const json = await res.json();

      if (!res.ok || !json.success) {
        const message = json.errors?.[0]?.msg || json.message || "Something went wrong. Please try again.";
        throw new Error(message);
      }

      form.style.display = "none";
      thanksEl?.removeAttribute("hidden");
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
        errorEl.removeAttribute("hidden");
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  const renderBar = (labelText: string, count: number, total: number): HTMLElement => {
    const pct = total > 0 ? Math.round((count / total) * 100) : 0;

    const row = document.createElement("div");
    row.className = "poll-bar-row";

    const labelEl = document.createElement("div");
    labelEl.className = "poll-bar-label";
    labelEl.textContent = labelText;

    const track = document.createElement("div");
    track.className = "poll-bar-track";
    const fill = document.createElement("div");
    fill.className = "poll-bar-fill";
    fill.style.width = `${pct}%`;
    track.appendChild(fill);

    const countEl = document.createElement("div");
    countEl.className = "poll-bar-count";
    countEl.textContent = `${count} (${pct}%)`;

    row.appendChild(labelEl);
    row.appendChild(track);
    row.appendChild(countEl);
    return row;
  };

  const renderResults = (data: { totalResponses: number; questions: PollResultsQuestion[] }) => {
    if (!resultsCharts || !totalResponsesEl) return;

    totalResponsesEl.textContent = `${data.totalResponses} response${data.totalResponses === 1 ? "" : "s"} so far`;
    resultsCharts.innerHTML = "";

    (data.questions || []).forEach((question) => {
      const block = document.createElement("div");
      block.className = "poll-result-block";

      const heading = document.createElement("h4");
      heading.className = "poll-result-question";
      heading.textContent = question.label;
      block.appendChild(heading);

      if (question.type === "scale") {
        const avg = document.createElement("p");
        avg.className = "poll-result-average";
        avg.textContent = question.average != null ? `Average: ${question.average} / 5` : "No responses yet";
        block.appendChild(avg);
        for (let i = 1; i <= 5; i += 1) {
          block.appendChild(renderBar(String(i), question.distribution?.[i] || 0, data.totalResponses));
        }
      } else if (question.type === "text") {
        const p = document.createElement("p");
        p.textContent = `${question.answeredCount || 0} response${question.answeredCount === 1 ? "" : "s"}`;
        block.appendChild(p);
      } else {
        (question.options || []).forEach((option) => {
          block.appendChild(renderBar(option, question.counts?.[option] || 0, data.totalResponses));
        });
      }

      resultsCharts.appendChild(block);
    });
  };

  resultsBtn?.addEventListener("click", async () => {
    if (!activeSlug || !resultsPanel || !resultsBtn) return;

    resultsBtn.disabled = true;
    resultsBtn.textContent = "Loading…";

    try {
      const res = await fetch(`${API_BASE}/${activeSlug}/results`);
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || "Unable to load results");

      renderResults(json.data);
      resultsPanel.removeAttribute("hidden");
      resultsBtn.style.display = "none";
    } catch (err) {
      resultsBtn.textContent = "View Poll Results";
      resultsBtn.disabled = false;
    }
  });

  loadActivePoll();
</script>
