---
import BaseLayout from "../components/BaseLayout.astro";

const phases = [
  {
    n: "1",
    label: "Define the Work",
    tagline: "Diagnose what is really required before anything is committed.",
    capabilities: [
      {
        num: "01",
        name: "Diagnose",
        desc: "Frame the business need, the operating context and the work required before committing investment.",
      },
      {
        num: "02",
        name: "Choose",
        desc: "Make strategic, evidence-informed choices between competing options, with explicit reasoning.",
      },
      {
        num: "03",
        name: "Translate",
        desc: "Convert strategic intent into briefs, mandates and language that delivery and the business can act on.",
      },
    ],
  },
  {
    n: "2",
    label: "Govern the Work",
    tagline: "Hold the work, the people & the system together through delivery.",
    capabilities: [
      {
        num: "01",
        name: "Select",
        desc: "Determine the right delivery shape — portfolio, program, project, product or hybrid — for the work at hand.",
      },
      {
        num: "02",
        name: "Integrate",
        desc: "Coordinate across functions, vendors, governance bodies and operating models so the whole system works.",
      },
      {
        num: "03",
        name: "Deliver",
        desc: "Sponsor major milestones, unblock dependencies and protect the conditions delivery needs.",
      },
    ],
  },
  {
    n: "3",
    label: "Protect the Work",
    tagline: "Keep value, risk and accountability visible from intent to operation.",
    capabilities: [
      {
        num: "01",
        name: "Protect",
        desc: "Hold risk, security, ethics and AI exposure as visible executive concerns, not delivery-team tasks.",
      },
      {
        num: "02",
        name: "Align",
        desc: "Keep stakeholders, governance and operating model aligned as the work evolves.",
      },
      {
        num: "03",
        name: "Govern",
        desc: "Maintain clear decision rights, investment discipline and accountability through change.",
      },
    ],
  },
  {
    n: "4",
    label: "Land the Value",
    tagline: "Make the result stick in adoption, in operations, in sustained value.",
    capabilities: [
      {
        num: "01",
        name: "Optimize",
        desc: "Adjust the work in flight, with the business case and value thesis always visible.",
      },
      {
        num: "02",
        name: "Adopt",
        desc: "Drive adoption through change, capability, communication and sponsorship — not just deployment.",
      },
      {
        num: "03",
        name: "Sustain",
        desc: "Transition outcomes into the operating model and protect benefits realization over time",
      },
    ],
  },
];

const seats = [
  "CEO",
  "CIO",
  "CHRO",
  "CFO",
  "COO",
  "Chief Transformation Officer",
  "PMO Leader",
  "Business-Unit Leader",
];

const views = [
  {
    num: "01",
    title: "Value cycle",
    desc: "Define the Work, Govern the Work, Protect the Work and Land the Value.",
  },
  {
    num: "02",
    title: "Capability set",
    desc: "Twelve leadership acts & the established practice domains they draw upon.",
  },
  {
    num: "03",
    title: "Role-demand model",
    desc: "The depth required varies by seat, context and consequence.",
  },
  {
    num: "04",
    title: "Capability-management system",
    desc: "Capability is assessed, developed, applied, evidenced and refreshed.",
  },
];

const conceptCards = [
  {
    eyebrow: "EXTERNAL CONCEPT",
    title: "The Leadership Economy",
    desc: "The broader thinking behind RAPL™'s approach to leadership and value.",
    linkText: "Explore ↗",
    href: "https://samiawaqar.com/leadership-economy",
    isExternal: true,
  },
  {
    eyebrow: "INTERNAL",
    title: "Research and Validation",
    desc: "A transparent agenda testing content validity, role demand and intervention effectiveness.",
    linkText: "Read the evidence position →",
    href: "/research",
    isExternal: false,
  },
  {
    eyebrow: "INTERNAL",
    title: "Executive Certificate",
    desc: "A fifty-hour development program across the twelve RAPL™ modules with an integrated capstone.",
    linkText: "See the program →",
    href: "/certificate",
    isExternal: false,
  },
];
---

<BaseLayout
  title="RAPL™ Framework — Executive Leadership Framework"
  description="Role-Agnostic Project Leadership (RAPL™) is a leadership capability framework designed to help organizations examine & address the gap between what strategic work requires & what leadership systems deliberately build."
>
  <!-- ==================== 1. HERO SECTION (Exact Figma Frame 313964) ==================== -->
  <section class="page-hero page-hero--framework">
    <div class="site-shell">
      <div class="framework-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: clamp(1.25rem, 1.6vw, 2rem); letter-spacing: 0.08em; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
          EXECUTIVE OFFICER
        </div>
        <h1 class="framework-hero-title">
          A leadership framework for the work leaders <span style="color: #755436;">are already expected to govern.</span>
        </h1>
        <p class="framework-hero-lede">
          Role-Agnostic Project Leadership™ is a leadership capability framework designed
          to help organizations examine &amp; address the gap between what strategic work requires
          &amp; what leadership systems deliberately build. The model follows the full value path
          from business need &amp; strategic choice through governance, delivery risk, adoption
          &amp; sustained operational value <a href="/" style="color: #755436; font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">the same Leadership Capability Gap introduced on the RAPL™ home page</a>.
        </p>
        <div class="button-row">
          <a class="button primary" href="/certificate" style="background: #3C3B3B; color: #ffffff; border: 1px solid #3C3B3B; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Explore the Executive Certificate→
          </a>
          <a class="button" href="/assessment" style="background: transparent; color: #102033; border: 1.5px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Start the Diagnostic
          </a>
        </div>
      </div>
      <!-- Mobile/tablet only: image as separate element below text (avoids text overlap on cropped background) -->
      <img
        class="framework-hero-image-mobile reveal-on-scroll"
        src="/ChatGPT_Image_Aug_16__2026__09_32_46_PM_1.png"
        alt="Executive office with city view"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- ==================== 2. WHAT ROLE-AGNOSTIC MEANS ==================== -->
  <section class="section" style="background: #FAF7F5; padding-block: clamp(4.5rem, 7.5vw, 6.5rem);">
    <div class="site-shell">
      <div class="split-layout reveal-on-scroll" style="align-items: flex-start; gap: 3.5rem;">
        <div>
          <div class="eyebrow" style="color: #755436; font-size: clamp(1.25rem, 1.6vw, 2rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
            WHAT ROLE-AGNOSTIC MEANS
          </div>
          <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; line-height: 1.1; margin-top: 0.75rem; max-width: 16ch;">
            The capability follows the work, not the job title.
          </h2>
        </div>
        <div>
          <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.65; color: #000000;">
            Role-agnostic means the capability follows the work, not the job title. Any
            leader who sponsors, governs, prioritizes, shapes, enables or depends on
            strategic initiatives may require RAPL™ capability.
          </p>
          <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.65; color: #000000; margin-top: 1.25rem;">
            It does not mean every role requires the same depth. A CEO, CIO, CHRO, CFO, COO,
            chief transformation officer, PMO leader and business-unit leader should each be
            assessed against the demands of the seat and the consequences of weak
            performance — a comparison made explicit through the
            <a href="/assessment" style="color: #0F1E31; font-weight: 700; text-decoration: underline; text-underline-offset: 3px;"> Leadership Capability Alignment Diagnostic</a>.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem;">
            {seats.map((s) => (
              <span class="framework-pill" style="color: #4C4747; border-color: #4C4747; background: transparent;">
                {s}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. A CLEAR DISTINCTION ==================== -->
  <section class="section section--framework-distinction">
    <div class="site-shell">
      <div class="framework-distinction-card reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: clamp(1.25rem, 1.6vw, 2rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          A CLEAR DISTINCTION
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; line-height: 1.12; margin-top: 0.75rem; margin-bottom: 1.75rem; max-width: 36ch; margin-inline: auto;">
          Executive project leadership, not practitioner substitution.
        </h2>
        <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.45; color: #4C4747; max-width: 72ch; margin-inline: auto;">
          RAPL™ does not ask senior leaders to build schedules, maintain backlogs,
          manage RAID logs or perform the specialist work of delivery teams. It asks
          them to know what questions the evidence should answer, when information is
          insufficient, when risk is being normalized, when a dependency needs
          executive action, when a business case has weakened and when work should
          stop.
        </p>
        <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.45; color: #4C4747; max-width: 72ch; margin-inline: auto; margin-top: 1.25rem;">
          This distinction — between leading the work and performing it — is what the
          twelve capabilities below are built to develop.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== 4. THE FULL MODEL (4 PHASES, 12 CAPABILITIES) ==================== -->
  <section class="section" id="full-model" style="background: #F6F4F2; padding-block: clamp(4.5rem, 8vw, 7rem);">
    <div class="site-shell">
      <div style="max-width: 60rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #4C4747; font-size: clamp(1.25rem, 1.6vw, 2rem); letter-spacing: 0.06em; font-weight: 700; margin-bottom: 0.5rem;">
          THE FULL MODEL
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08;">
          Four phases. Twelve capabilities. One value cycle.
        </h2>
        <p class="lede" style="margin-top: 1.25rem; font-size: clamp(1.15rem, 1.45vw, 1.75rem); color: #000000; line-height: 1.55; max-width: 56ch;">
          Each phase groups three leadership acts. The same capability can be exercised
          in different phases and at different depths depending on the seat and the work.
        </p>
      </div>

      <div class="phases-grid reveal-on-scroll" style="margin-top: 3rem;">
        {phases.map((p) => (
          <article class="phase" style="border-left: 14px solid #3C3B3B; background: #F4F2EF;">
            <div class="phase-eyebrow" style="color: #4C4747; font-weight: 600;">PHASE {p.n}</div>
            <h3 style="color: #4C4747;">{p.label}</h3>
            <p class="phase-tagline" style="color: #000000; border-bottom-color: #535252;">{p.tagline}</p>
            <div class="phase-grid">
              {p.capabilities.map((c) => (
                <div class="capability" style="border-right-color: #535252;">
                  <span class="capability-number" style="color: #4C4747;">{c.num}</span>
                  <h4 style="color: #4C4747; font-size: clamp(1.15rem, 1.45vw, 1.75rem); font-weight: 700; line-height: 1.2;">{c.name}</h4>
                  <p style="color: #000000; font-size: 1.4375rem; line-height: 1.5;">{c.desc}</p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div style="margin-top: 3rem;" class="reveal-on-scroll">
        <a class="button primary" href="/certificate" style="background: #3C3B3B; color: #FFFFFF; font-size: 0.85rem; font-weight: 700; padding: 0.6rem 1.25rem; border-radius: 4px; text-decoration: none;">
          Explore the complete RAPL™ Framework→
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== 5. HOW TO READ THE MODEL (4 VIEWS) ==================== -->
  <section class="section section--framework-views">
    <div class="site-shell">
      <div style="max-width: 60rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #4C4747; font-size: clamp(1.25rem, 1.6vw, 2rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          HOW TO READ THE MODEL
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          Four views of one model.
        </h2>
        <p class="lede" style="margin-top: 1.25rem; font-size: clamp(1.15rem, 1.45vw, 1.75rem); color: #4C4747; line-height: 1.55; max-width: 56ch;">
          RAPL™ can be read as four different things at once — depending on what the work needs from you.
        </p>
      </div>

      <div class="framework-views-grid reveal-on-scroll">
        {views.map((v) => (
          <div class="framework-view-card">
            <div class="framework-view-num">{v.num}</div>
            <h3 class="framework-view-title">{v.title}</h3>
            <p class="framework-view-desc">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 6. AT ORGANIZATIONAL SCALE ==================== -->
  <section class="section" style="background: #F9F8F4; padding-block: clamp(4.5rem, 8vw, 7rem);">
    <div class="site-shell">
      <div class="split-layout reveal-on-scroll" style="align-items: center; gap: 3.5rem;">
        <div>
          <div class="eyebrow" style="color: #755436; font-size: clamp(1.25rem, 1.6vw, 2rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
            AT ORGANIZATIONAL SCALE
          </div>
          <h2 style="color: #3C3B3B; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; line-height: 1.1; margin-top: 0.75rem; max-width: 18ch;">
            Embedding RAPL™ into roles, governance and talent systems.
          </h2>
          <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.65; color: #000000; margin-top: 1.5rem; max-width: 48ch;">
            The framework is most effective when it moves beyond individual
            development and shapes role design, governance forums, performance
            standards &amp; succession criteria across the leadership system.
          </p>
          <div class="button-row" style="margin-top: 2rem; gap: 1rem;">
            <a class="button primary" href="/organizations" style="background: #755436; color: #ffffff; border: 1px solid #755436; border-radius: 4px; font-weight: 700; font-size: 0.95rem; padding: 0.7rem 1.5rem;">
              See organizational application→
            </a>
            <a class="button" href="/assessment" style="background: transparent; color: #102033; border: 1.5px solid #755436; border-radius: 4px; font-weight: 700; font-size: 0.95rem; padding: 0.7rem 1.5rem; text-decoration: none;">
              Run the Alignment Diagnostic
            </a>
          </div>
        </div>

        <!-- Right Callout Box (Figma dark container #3C3B3B) -->
        <div class="framework-callout-card">
          <h3 style="color: #ffffff; font-size: clamp(2.5rem, 3.3vw, 4rem); font-weight: 700; margin: 0 0 1rem; line-height: 1.1;">
            The capability gap
          </h3>
          <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.45; color: #ffffff; margin: 0 0 1.25rem;">
            A <strong>capability gap</strong> exists when the capability a strategic role
            requires is not what the leadership system deliberately develops, assesses or
            rewards.
          </p>
          <p style="font-size: clamp(1.15rem, 1.45vw, 1.75rem); line-height: 1.45; color: #ffffff; margin: 0 0 1.75rem;">
            RAPL™ is built to make that gap visible, then close it — through seat
            profiles, capability baselines, gap heatmaps and governance integration.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
            <span class="framework-pill" style="color: #ffffff; border-color: #ffffff; background: transparent;">
              Seat Profiles
            </span>
            <span class="framework-pill" style="color: #ffffff; border-color: #ffffff; background: transparent;">
              Baselines
            </span>
            <span class="framework-pill" style="color: #ffffff; border-color: #ffffff; background: transparent;">
              Heatmaps
            </span>
            <span class="framework-pill" style="color: #ffffff; border-color: #ffffff; background: transparent;">
              Targeted development
            </span>
            <span class="framework-pill" style="color: #ffffff; border-color: #ffffff; background: transparent;">
              Governance integration
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 7. 3 CONCEPT CARDS (EXTERNAL / INTERNAL) ==================== -->
  <section class="section section--framework-concepts">
    <div class="site-shell">
      <div class="framework-concepts-grid reveal-on-scroll">
        {conceptCards.map((c) => (
          <a
            class="framework-concept-card"
            href={c.href}
            target={c.isExternal ? "_blank" : undefined}
            rel={c.isExternal ? "noopener noreferrer" : undefined}
          >
            <div>
              <div class="framework-concept-eyebrow">
                {c.eyebrow}
              </div>
              <h3 class="framework-concept-title">
                {c.title}
              </h3>
              <p class="framework-concept-desc">
                {c.desc}
              </p>
            </div>
            <span class="framework-concept-link">
              <span class="framework-concept-arrow" aria-hidden="true">→</span>
              <span class="framework-concept-text">{c.linkText}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 8. NEXT STEP CTA ==================== -->
  <section class="section" id="cta" style="background: #F6F3EA; padding-block: clamp(5rem, 9vw, 8rem); border-top: 1px solid rgba(15, 30, 49, 0.08);">
    <div class="site-shell reveal-on-scroll">
      <div class="eyebrow" style="color: #4C4747; font-size: clamp(1.25rem, 1.6vw, 2rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
        BEGIN THE FRAMEWORK
      </div>
      <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 6rem); font-weight: 700; line-height: 1.1; max-width: 28ch;">
        Explore the model. Build the capability. Govern the work.
      </h2>
      <p style="color: #000000; font-size: clamp(1.15rem, 1.45vw, 1.75rem); margin-top: 1.5rem; max-width: 58ch; line-height: 1.5;">
        Whether you're an individual senior leader, an organization, or a researcher — there is a structured on-ramp.
      </p>
      <div class="button-row" style="margin-top: 2.5rem; gap: 1rem;">
        <a class="button primary" href="/assessment" style="background: #755436; color: #ffffff; border: 1px solid #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          Start the Diagnostic→
        </a>
        <a class="button" href="/contact" style="background: transparent; border: 1.5px solid #755436; color: #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          Contact RAPL™ Leadership
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


