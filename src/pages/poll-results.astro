---
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout
  title="Poll Results | RAPL™ Leadership"
  description="Live presenter view of RAPL™ audience poll results."
  noindex
>
  <section class="presenter-shell">
    <p id="presenter-loading" class="poll-loading">Loading…</p>
    <p id="presenter-unavailable" class="poll-loading" hidden>This poll isn't available right now.</p>

    <div id="presenter-view" hidden>
      <header class="presenter-header">
        <h1 id="presenter-title" class="presenter-title"></h1>
        <p id="presenter-progress" class="presenter-progress"></p>
      </header>

      <div class="presenter-question-card">
        <h2 id="presenter-question-label" class="presenter-question-label"></h2>
        <p id="presenter-answered-count" class="presenter-answered-count"></p>

        <button type="button" id="presenter-reveal-btn" class="button primary">
          Reveal results
        </button>

        <div id="presenter-bars" hidden></div>
      </div>

      <div class="presenter-nav">
        <button type="button" id="presenter-back-btn" class="poll-nav-btn poll-nav-btn--ghost">
          ← Previous
        </button>
        <button type="button" id="presenter-next-btn" class="poll-nav-btn poll-nav-btn--primary">
          Next →
        </button>
      </div>

      <footer class="presenter-footer">
        Audience responses are self-reported and not a validated capability assessment.
      </footer>
    </div>
  </section>
</BaseLayout>

<script>
  interface PollQuestion {
    key: string;
    label: string;
    type: "single" | "multi" | "scale" | "text";
    options?: string[];
    required?: boolean;
  }

  interface PollResultsQuestion extends PollQuestion {
    counts?: Record<string, number>;
    percentages?: Record<string, number>;
    distribution?: Record<string, number>;
    average?: number | null;
    answeredCount: number;
  }

  interface PollResults {
    totalResponses: number;
    questions: PollResultsQuestion[];
  }

  const API_BASE = "https://api.snsccs.com/api/rapl-audience-poll";
  const params = new URLSearchParams(window.location.search);
  const slugParam = params.get("poll");

  // A virtual final "step" after the last real question — the closing
  // overview screen. currentIndex can reach questions.length to mean "on
  // the overview step"; there is no step after that (Next stays disabled).
  const OVERVIEW_KEY = "__overview__";

  let pollSlug: string | null = null;
  let questions: PollQuestion[] = [];
  let currentIndex = 0;
  let latestResults: PollResults | null = null;
  const revealed = new Set<string>();

  const loadingEl = document.getElementById("presenter-loading");
  const unavailableEl = document.getElementById("presenter-unavailable");
  const viewEl = document.getElementById("presenter-view");
  const titleEl = document.getElementById("presenter-title");
  const progressEl = document.getElementById("presenter-progress");
  const questionLabelEl = document.getElementById("presenter-question-label");
  const answeredCountEl = document.getElementById("presenter-answered-count");
  const revealBtn = document.getElementById("presenter-reveal-btn") as HTMLButtonElement | null;
  const barsEl = document.getElementById("presenter-bars");
  const backBtn = document.getElementById("presenter-back-btn") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("presenter-next-btn") as HTMLButtonElement | null;

  const renderBar = (labelText: string, count: number, pct: number): HTMLElement => {
    const row = document.createElement("div");
    row.className = "poll-bar-row";

    const labelEl = document.createElement("div");
    labelEl.className = "poll-bar-label";
    labelEl.textContent = labelText;

    const track = document.createElement("div");
    track.className = "poll-bar-track";
    const fill = document.createElement("div");
    fill.className = "poll-bar-fill";
    fill.style.width = `${pct}%`;
    track.appendChild(fill);

    const figure = document.createElement("div");
    figure.className = "poll-bar-figure";
    const pctEl = document.createElement("span");
    pctEl.className = "poll-bar-pct";
    pctEl.textContent = `${pct}%`;
    const countEl = document.createElement("span");
    countEl.className = "poll-bar-count";
    countEl.textContent = `· ${count} response${count === 1 ? "" : "s"}`;
    figure.appendChild(pctEl);
    figure.appendChild(countEl);

    row.appendChild(labelEl);
    row.appendChild(track);
    row.appendChild(figure);
    return row;
  };

  const renderBarsForQuestion = (key: string) => {
    if (!barsEl || !answeredCountEl) return;
    const result = latestResults?.questions.find((q) => q.key === key);

    if (!result) {
      answeredCountEl.textContent = "0 responses";
      barsEl.innerHTML = "";
      return;
    }

    const total = latestResults?.totalResponses ?? 0;
    answeredCountEl.textContent =
      result.answeredCount === total
        ? `${total} response${total === 1 ? "" : "s"}`
        : `${result.answeredCount} of ${total} respondents answered`;
    barsEl.innerHTML = "";

    if (result.type === "scale") {
      const avg = document.createElement("p");
      avg.className = "poll-result-average";
      avg.textContent = result.average != null ? `Average: ${result.average} / 5` : "No responses yet";
      barsEl.appendChild(avg);
      for (let i = 1; i <= 5; i += 1) {
        const count = result.distribution?.[i] || 0;
        const pct = result.answeredCount > 0 ? Math.round((count / result.answeredCount) * 1000) / 10 : 0;
        barsEl.appendChild(renderBar(String(i), count, pct));
      }
    } else if (result.type === "text") {
      const p = document.createElement("p");
      p.textContent = `${result.answeredCount} response${result.answeredCount === 1 ? "" : "s"}`;
      barsEl.appendChild(p);
    } else {
      (result.options || []).forEach((option) => {
        const count = result.counts?.[option] || 0;
        const pct = result.percentages?.[option] ?? 0;
        barsEl.appendChild(renderBar(option, count, pct));
      });
    }
  };

  // ---- Overview screen: one small vertical bar chart per question ----
  // Fixed 0-100% y-domain on every chart (not auto-scaled per question) so
  // the small multiples are genuinely comparable at a glance, per how this
  // poll already reports percentages (each against that question's own
  // answered count, not the overall response count).
  const CHART = {
    barSlot: 72,
    gap: 14,
    plotHeight: 130,
    topMargin: 26,
    leftMargin: 36,
    rightMargin: 10,
    labelLines: 3,
    labelLineHeight: 16,
    labelCharsPerLine: 10
  };

  const wrapLabel = (text: string): string[] => {
    const words = text.split(/\s+/);
    const lines: string[] = [];
    let current = "";

    words.forEach((word) => {
      const candidate = current ? `${current} ${word}` : word;
      if (candidate.length <= CHART.labelCharsPerLine || !current) {
        current = candidate;
      } else {
        lines.push(current);
        current = word;
      }
    });
    if (current) lines.push(current);

    if (lines.length > CHART.labelLines) {
      const kept = lines.slice(0, CHART.labelLines);
      kept[CHART.labelLines - 1] = `${kept[CHART.labelLines - 1].slice(0, CHART.labelCharsPerLine - 1)}…`;
      return kept;
    }
    return lines;
  };

  const svgEl = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>) => {
    const el = document.createElementNS("http://www.w3.org/2000/svg", tag);
    Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value)));
    return el;
  };

  const buildVerticalBarChart = (bars: Array<{ label: string; pct: number; count: number }>): SVGSVGElement => {
    const plotWidth = bars.length * CHART.barSlot;
    const labelBlockHeight = CHART.labelLines * CHART.labelLineHeight + 8;
    const width = CHART.leftMargin + plotWidth + CHART.rightMargin;
    const height = CHART.topMargin + CHART.plotHeight + labelBlockHeight + 8;
    const baselineY = CHART.topMargin + CHART.plotHeight;

    const svg = svgEl("svg", {
      viewBox: `0 0 ${width} ${height}`,
      class: "poll-vbar-chart",
      role: "img",
      "aria-label": "Bar chart of responses by option"
    });

    // Gridlines + y-axis labels at 0/25/50/75/100%.
    [0, 25, 50, 75, 100].forEach((tick) => {
      const y = baselineY - (tick / 100) * CHART.plotHeight;
      svg.appendChild(svgEl("line", {
        x1: CHART.leftMargin,
        y1: y,
        x2: width - CHART.rightMargin,
        y2: y,
        stroke: "rgba(115, 82, 54, 0.15)",
        "stroke-width": 1
      }));
      const tickLabel = svgEl("text", {
        x: CHART.leftMargin - 8,
        y: y + 4,
        "text-anchor": "end",
        "font-size": 12,
        fill: "#8C8378"
      });
      tickLabel.textContent = `${tick}%`;
      svg.appendChild(tickLabel);
    });

    bars.forEach((bar, index) => {
      const slotX = CHART.leftMargin + index * CHART.barSlot;
      const barWidth = CHART.barSlot - CHART.gap;
      const barHeight = Math.max((bar.pct / 100) * CHART.plotHeight, 0);
      const x = slotX + CHART.gap / 2;
      const yTop = baselineY - barHeight;
      const radius = Math.min(4, barHeight / 2);

      if (barHeight > 0.5) {
        const path = svgEl("path", {
          d: `M ${x} ${baselineY}
              L ${x} ${yTop + radius}
              Q ${x} ${yTop} ${x + radius} ${yTop}
              L ${x + barWidth - radius} ${yTop}
              Q ${x + barWidth} ${yTop} ${x + barWidth} ${yTop + radius}
              L ${x + barWidth} ${baselineY} Z`,
          fill: "#755436"
        });
        svg.appendChild(path);
      }

      const valueLabel = svgEl("text", {
        x: x + barWidth / 2,
        y: Math.max(yTop - 8, CHART.topMargin - 10),
        "text-anchor": "middle",
        "font-size": 14,
        "font-weight": 700,
        fill: "#3C3B3B"
      });
      valueLabel.textContent = `${bar.pct}%`;
      svg.appendChild(valueLabel);

      const categoryLabel = svgEl("text", {
        x: x + barWidth / 2,
        y: baselineY + 18,
        "text-anchor": "middle",
        "font-size": 12,
        "font-weight": 600,
        fill: "#3C3B3B"
      });
      wrapLabel(bar.label).forEach((line, lineIndex) => {
        const tspan = svgEl("tspan", {
          x: x + barWidth / 2,
          dy: lineIndex === 0 ? 0 : CHART.labelLineHeight
        });
        tspan.textContent = line;
        categoryLabel.appendChild(tspan);
      });
      svg.appendChild(categoryLabel);
    });

    return svg as unknown as SVGSVGElement;
  };

  const renderOverview = () => {
    if (!barsEl || !answeredCountEl || !latestResults) return;

    answeredCountEl.textContent = `${latestResults.totalResponses} response${latestResults.totalResponses === 1 ? "" : "s"} total`;
    barsEl.innerHTML = "";

    const grid = document.createElement("div");
    grid.className = "poll-overview-grid";

    latestResults.questions.forEach((question) => {
      const card = document.createElement("div");
      card.className = "poll-chart-card";

      const heading = document.createElement("h4");
      heading.className = "poll-chart-title";
      heading.textContent = question.label;
      heading.title = question.label;
      card.appendChild(heading);

      if (question.type === "text") {
        const p = document.createElement("p");
        p.className = "poll-chart-subtext";
        p.textContent = `${question.answeredCount || 0} response${question.answeredCount === 1 ? "" : "s"}`;
        card.appendChild(p);
      } else if (question.type === "scale") {
        const bars = [1, 2, 3, 4, 5].map((i) => {
          const count = question.distribution?.[i] || 0;
          const pct = question.answeredCount > 0 ? Math.round((count / question.answeredCount) * 1000) / 10 : 0;
          return { label: String(i), pct, count };
        });
        card.appendChild(buildVerticalBarChart(bars));
        if (question.average != null) {
          const avg = document.createElement("p");
          avg.className = "poll-chart-subtext";
          avg.textContent = `Average: ${question.average} / 5`;
          card.appendChild(avg);
        }
      } else {
        const bars = (question.options || []).map((option) => ({
          label: option,
          pct: question.percentages?.[option] ?? 0,
          count: question.counts?.[option] || 0
        }));
        card.appendChild(buildVerticalBarChart(bars));
      }

      grid.appendChild(card);
    });

    barsEl.appendChild(grid);
  };

  const currentStepKey = (): string | null => {
    if (currentIndex === questions.length) return OVERVIEW_KEY;
    return questions[currentIndex]?.key ?? null;
  };

  const renderCurrentQuestion = () => {
    if (!questionLabelEl || !progressEl || !revealBtn || !barsEl || !backBtn || !nextBtn) return;
    const isOverviewStep = currentIndex === questions.length;
    viewEl?.classList.toggle("is-overview", isOverviewStep);

    if (isOverviewStep) {
      questionLabelEl.textContent = "Overall Poll Results";
      progressEl.textContent = "Overview";
    } else {
      const question = questions[currentIndex];
      if (!question) return;
      questionLabelEl.textContent = question.label;
      progressEl.textContent = `Question ${currentIndex + 1} of ${questions.length}`;
    }

    backBtn.disabled = currentIndex === 0;
    nextBtn.disabled = currentIndex === questions.length;
    nextBtn.textContent = currentIndex === questions.length - 1 ? "See overview →" : "Next →";

    const key = currentStepKey();
    const isRevealed = key !== null && revealed.has(key);
    revealBtn.hidden = isRevealed;
    barsEl.hidden = !isRevealed;

    if (isRevealed && key) {
      if (isOverviewStep) renderOverview();
      else renderBarsForQuestion(key);
    } else if (answeredCountEl) {
      answeredCountEl.textContent = "";
    }
  };

  revealBtn?.addEventListener("click", () => {
    const key = currentStepKey();
    if (!key) return;
    revealed.add(key);
    renderCurrentQuestion();
  });

  backBtn?.addEventListener("click", () => {
    if (currentIndex === 0) return;
    currentIndex -= 1;
    renderCurrentQuestion();
  });

  nextBtn?.addEventListener("click", () => {
    if (currentIndex === questions.length) return;
    currentIndex += 1;
    renderCurrentQuestion();
  });

  const connectLiveUpdates = (slug: string) => {
    if (typeof EventSource === "undefined") return;

    const source = new EventSource(`${API_BASE}/${slug}/results/stream`);
    source.onmessage = (event) => {
      try {
        latestResults = JSON.parse(event.data) as PollResults;
        const key = currentStepKey();
        if (!key || !revealed.has(key)) return;
        if (key === OVERVIEW_KEY) renderOverview();
        else renderBarsForQuestion(key);
      } catch {
        // Ignore malformed events; the next push will self-correct.
      }
    };
  };

  const loadPoll = async () => {
    try {
      const endpoint = slugParam ? `${API_BASE}/${encodeURIComponent(slugParam)}` : `${API_BASE}/active`;
      const res = await fetch(endpoint);
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message || "Unable to load poll");

      pollSlug = json.data.slug;
      questions = Array.isArray(json.data.questions) ? json.data.questions : [];
      if (titleEl) titleEl.textContent = json.data.title;

      loadingEl?.setAttribute("hidden", "true");
      viewEl?.removeAttribute("hidden");

      renderCurrentQuestion();
      if (pollSlug) connectLiveUpdates(pollSlug);
    } catch (err) {
      loadingEl?.setAttribute("hidden", "true");
      unavailableEl?.removeAttribute("hidden");
    }
  };

  loadPoll();
</script>
