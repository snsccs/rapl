---
import BaseLayout from "../components/BaseLayout.astro";
import CTA from "../components/CTA.astro";

const steps = [
  { title: "Define the strategic work", desc: "Identify the initiatives, portfolios and AI-enabled change the senior leadership team is accountable for in the next 12–24 months." },
  { title: "Map the seats against the work", desc: "Identify which RAPL™ capabilities each senior role is expected to exercise, and at what depth, in this work." },
  { title: "Baseline current capability", desc: "Assess current leadership capability against the twelve RAPL™ capabilities, using evidence beyond self-report where possible." },
  { title: "Surface the gap as a heatmap", desc: "Compare role demand and current capability in a visible, role-by-role, capability-by-capability heatmap." },
  { title: "Prioritize the development", desc: "Use the heatmap to target the highest-consequence gaps first — through cohort programs, targeted modules, coaching and governance work." },
];

const outputs = [
  "A seat-by-seat view of capability demand for the work ahead.",
  "A role-by-role, capability-by-capability baseline.",
  "A visible heatmap of the Leadership Capability Gap.",
  "Prioritized development recommendations tied to strategic work.",
  "A re-measurement plan to track whether the gap is closing.",
];

const heatmap = [
  { seat: "CEO", cells: ["low", "med", "low", "med"] },
  { seat: "CIO", cells: ["med", "high", "high", "low"] },
  { seat: "CHRO", cells: ["low", "med", "low", "low"] },
  { seat: "CFO", cells: ["med", "low", "med", "low"] },
  { seat: "COO", cells: ["med", "med", "med", "med"] },
  { seat: "CxO Trans.", cells: ["high", "high", "low", "low"] },
];
---

<BaseLayout
  title="Leadership Capability Alignment Diagnostic"
  description="A structured way to compare what senior roles require with what leadership and talent systems develop, assess and reward."
>
  <section class="page-hero page-hero--paper">
    <div class="site-shell page-hero-grid reveal-on-scroll">
      <div class="eyebrow page-hero-eyebrow">Leadership Capability Alignment Diagnostic</div>
      <h1>Make the leadership capability gap visible — by seat, by capability, by consequence.</h1>
      <p class="lede">
        A structured way to compare what senior roles require with what leadership and
        talent systems develop, assess and reward. The diagnostic is the entry point to
        every RAPL™ engagement.
      </p>
      <div class="button-row">
        <a class="button primary" href="/contact?interest=diagnostic">
          Request the diagnostic
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="button ghost" href="/framework">See the framework</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="split-layout">
        <div class="reveal-on-scroll">
          <div class="eyebrow">What the diagnostic does</div>
          <h2 class="section-title" style="margin-top: 0.5rem;">It compares what the work demands with what the leadership system actually develops.</h2>
        </div>
        <div class="reveal-on-scroll">
          <p style="font-size: 1.05rem; line-height: 1.7; color: var(--graphite);">
            The Leadership Capability Alignment Diagnostic makes the gap between
            strategic work and leadership systems visible — not as an abstract idea,
            but as a concrete comparison you can act on.
          </p>
          <p style="font-size: 1.05rem; line-height: 1.7; color: var(--graphite); margin-top: 1rem;">
            It looks at each senior seat, the work it is expected to govern, the
            capability the work requires, and the capability the talent system
            actually develops, assesses and rewards. Where the two don't match, the
            gap is named — and prioritized.
          </p>
          <div class="chip-row">
            <span class="pill pill--brass">Seat profiles</span>
            <span class="pill pill--brass">Role demand</span>
            <span class="pill pill--brass">Capability baseline</span>
            <span class="pill pill--brass">Gap heatmap</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bond-deep">
    <div class="site-shell">
      <div style="max-width: 64rem;" class="reveal-on-scroll">
        <div class="eyebrow">The diagnostic process</div>
        <h2 class="display-title">Five steps from work to action.</h2>
        <p class="lede" style="margin-top: 1rem;">
          The diagnostic moves from defining the work, through mapping seats and baseline,
          to a visible heatmap and prioritized development plan.
        </p>
      </div>
      <ol class="prose-list" style="margin-top: 3.5rem; max-width: 60rem;">
        {steps.map((s) => (
          <li class="reveal-on-scroll" style="padding-left: 4.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(16, 32, 43, 0.08);">
            <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem;">{s.title}</h3>
            <p style="font-size: 1.02rem; line-height: 1.6; color: var(--graphite);">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="split-layout">
        <div class="reveal-on-scroll">
          <div class="eyebrow">What you get</div>
          <h2 class="section-title" style="margin-top: 0.5rem;">A diagnostic you can act on, not a report that sits on a shelf.</h2>
        </div>
        <div class="reveal-on-scroll">
          <ul class="dot-list" style="font-size: 1.05rem; line-height: 1.6; color: var(--graphite);">
            {outputs.map((o) => <li style="padding-left: 1.5rem; margin-bottom: 0.75rem;">{o}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bond-deep">
    <div class="site-shell">
      <div style="max-width: 60rem; margin: 0 auto;">
        <div class="text-center reveal-on-scroll" style="margin-bottom: 2.5rem;">
          <div class="eyebrow">What a heatmap looks like</div>
          <h2 class="display-title" style="margin-top: 0.5rem;">The gap, made visible.</h2>
        </div>
        <div class="heatmap reveal-on-scroll">
          <div class="heatmap-row header">
            <div>Seat</div>
            <div>Define</div>
            <div>Govern</div>
            <div>Protect</div>
            <div>Land</div>
          </div>
          {heatmap.map((row) => (
            <div class="heatmap-row">
              <div class="seat">{row.seat}</div>
              {row.cells.map((c) => <div class={`heatmap-cell ${c}`}>{c}</div>)}
            </div>
          ))}
          <div class="heatmap-legend">
            <span class="swatch low">Low</span>
            <span class="swatch med">Medium</span>
            <span class="swatch high">High demand</span>
          </div>
          <p style="font-size: 0.78rem; color: var(--graphite); margin-top: 1rem; font-style: italic;">Illustrative example only — actual heatmaps are generated for each organization from the diagnostic engagement.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="site-shell">
      <div class="grid-3">
        <div class="card reveal-on-scroll">
          <h3 style="font-size: 1.15rem;">Boards and CEOs</h3>
          <p style="font-size: 0.92rem; line-height: 1.55; color: var(--graphite); margin-top: 0.5rem;">Sanity-check whether the senior team has the leadership capability the strategic agenda actually requires.</p>
        </div>
        <div class="card reveal-on-scroll">
          <h3 style="font-size: 1.15rem;">CHROs and PMOs</h3>
          <p style="font-size: 0.92rem; line-height: 1.55; color: var(--graphite); margin-top: 0.5rem;">Target development and succession investment where the gap is highest and the consequences are greatest.</p>
        </div>
        <div class="card reveal-on-scroll">
          <h3 style="font-size: 1.15rem;">Transformation leaders</h3>
          <p style="font-size: 0.92rem; line-height: 1.55; color: var(--graphite); margin-top: 0.5rem;">Identify which leadership seats need strengthening before the next wave of AI and transformation work.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Begin the diagnostic"
    title="Make the gap visible. Then close it."
    description="The diagnostic is the structured entry point to every RAPL™ engagement."
    primary={{ label: "Request the diagnostic", href: "/contact?interest=diagnostic" }}
    secondary={{ label: "Read the research", href: "/research" }}
  />
</BaseLayout>
