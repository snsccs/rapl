---
import BaseLayout from "../components/BaseLayout.astro";

const format = [
  { value: "50", label: "HOURS", note: "Total executive development hours" },
  { value: "12", label: "MODULES", note: "Mapped to the twelve RAPL™ capabilities" },
  { value: "12–18", label: "COHORT", note: "Senior leaders per cohort" },
  { value: "Live", label: "CAPSTONE", note: "Real strategic work, not a simulation" },
];

const allModules = [
  { num: "01", name: "Diagnose the Work", phase: "DEFINE" },
  { num: "02", name: "Choose the Work", phase: "DEFINE" },
  { num: "03", name: "Translate the Work", phase: "DEFINE" },
  { num: "04", name: "Select the Shape", phase: "GOVERN" },
  { num: "05", name: "Integrate the System", phase: "GOVERN" },
  { num: "06", name: "Sponsor Delivery", phase: "GOVERN" },
  { num: "07", name: "Protect Value and Risk", phase: "PROTECT" },
  { num: "08", name: "Align Stakeholders", phase: "PROTECT" },
  { num: "09", name: "Govern Investment", phase: "PROTECT" },
  { num: "10", name: "Optimize in Flight", phase: "LAND" },
  { num: "11", name: "Drive Adoption", phase: "LAND" },
  { num: "12", name: "Sustain Benefits", phase: "LAND" },
];

const outcomes = [
  {
    num: "01",
    text: "A personal baseline across all twelve RAPL™ capabilities, measured against the demands of your seat.",
  },
  {
    num: "02",
    text: "Decision frameworks, briefs and tools you can apply in your live work during the program.",
  },
  {
    num: "03",
    text: "A peer cohort of senior leaders confronting the same kind of work — and a network that continues afterward.",
  },
  {
    num: "04",
    text: "A structured development path through the four phases — Define, Govern, Protect, Land.",
  },
  {
    num: "05",
    text: "An integrated capstone that turns learning into a personal leadership intervention for a real strategic challenge.",
  },
];

const steps = [
  {
    step: "STEP 1",
    title: "Baseline",
    desc: "A capability baseline and seat-demand assessment at the start, mapped to the twelve RAPL™ capabilities & the consequences of weak performance in your role.",
  },
  {
    step: "STEP 2",
    title: "Cohort work",
    desc: "A 12–18 person cohort of senior leaders working through the four phases, with case material drawn from real strategic, AI and transformation work.",
  },
  {
    step: "STEP 3",
    title: "Capstone",
    desc: "A personal leadership intervention on a live strategic challenge — assessed against the RAPL™ capabilities, peer-reviewed & applied in your work.",
  },
];

const whoItIsFor = [
  "CEOs, COOs and business-unit leaders accountable for strategic outcomes.",
  "CIOs, CHROs, CFOs and chief transformation officers who sponsor, govern or enable strategic work.",
  "PMO, delivery and execution-office leaders bridging strategy and operations.",
  "Senior leaders in functions that shape, enable or depend on AI and transformation initiatives.",
];

const isNotList = [
  "Project management training for executives.",
  "A replacement for PMO, change or delivery specialists.",
  "A generalist leadership program that ignores the work.",
];
---

<BaseLayout
  title="Executive Certificate | RAPL™ Leadership Program"
  description="A personalized 50-hour executive certificate built on 12 RAPL™ modules & an integrated capstone. Develop judgment to lead above, across & beyond."
>
  <!-- ==================== 1. HERO SECTION (Figma Node 6221:10324) ==================== -->
  <section class="page-hero page-hero--certificate">
    <div class="site-shell">
      <div class="cert-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; letter-spacing: 0.08em; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
          EXECUTIVE CERTIFICATE
        </div>
        <h1 class="cert-hero-title">
          Develop the executive judgment leaders need <span style="color: #755436;">above, across &amp; beyond</span> delivery.
        </h1>
        <p class="cert-hero-lede">
          A personalized, fifty-hour executive development program built around twelve RAPL™ modules and an integrated capstone.
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact?interest=certificate" style="background: #3C3B3B; color: #ffffff; border: 1px solid #3C3B3B; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Apply for the next cohort→
          </a>
          <a class="button" href="/framework" style="background: transparent; color: #102033; border: 1.5px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Explore the framework
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. WHO IT'S FOR ==================== -->
  <section class="section" style="background: #F2EEEB; padding-block: clamp(5rem, 8vw, 7.5rem);">
    <div class="site-shell site-shell--wide">
      <div class="cert-who-split reveal-on-scroll">
        <div class="cert-who-left">
          <div class="eyebrow" style="color: #755436; font-size: 1.35rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.75rem;">
            WHO IT’S FOR
          </div>
          <h2 style="color: #4C4747; font-size: clamp(2.4rem, 4.5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0; margin-bottom: 1.5rem;">
            Senior leaders accountable for strategic work they don't personally deliver
          </h2>
          <p style="font-size: 1.25rem; line-height: 1.6; color: #4C4747; margin: 0; max-width: 50ch;">
            RAPL™ is not project management training for executives. It develops the executive judgment, governance capability, integration skill, sponsorship discipline &amp; value leadership senior leaders need.
          </p>
        </div>

        <div class="cert-who-right">
          <ul class="cert-who-list">
            {whoItIsFor.map((item) => (
              <li class="cert-who-item">
                <span class="cert-who-dot" aria-hidden="true">·</span>
                <span class="cert-who-text">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. KEY NUMBERS / METRICS ==================== -->
  <section class="section section--tight" style="background: #FFFFFF; border-block: 1px solid rgba(15, 30, 49, 0.08); padding-block: 3.5rem;">
    <div class="site-shell">
      <div class="cert-stat-grid reveal-on-scroll">
        {format.map((f) => (
          <div class="cert-stat-item">
            <div class="cert-stat-num">{f.value}</div>
            <div class="cert-stat-label">{f.label}</div>
            <p class="cert-stat-desc">{f.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 4. CURRICULUM — 12 MODULES ==================== -->
  <section class="section section--cert-curriculum" id="curriculum">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          CURRICULUM
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem; max-width: 26ch;">
          Twelve modules. Four phases. One integrated program.
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.6; margin-top: 1.25rem; max-width: 60ch;">
          The certificate moves through the same value cycle RAPL™ describes — from diagnosing the right work, through governing and protecting it, to landing the value in operations.
        </p>
      </div>

      <div class="cert-modules-grid reveal-on-scroll">
        {allModules.map((m) => (
          <div class="cert-module-card">
            <div class="cert-module-header">
              <span class="cert-module-num">{m.num}</span>
              <span class="cert-module-badge">{m.phase}</span>
            </div>
            <h3 class="cert-module-title">{m.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 5. OUTCOMES ==================== -->
  <section class="section" style="background: #FFFFFF; padding-block: clamp(5rem, 8vw, 7.5rem); border-block: 1px solid rgba(15, 30, 49, 0.06);">
    <div class="site-shell">
      <div style="max-width: 60rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          OUTCOMES
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          What you leave with.
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.55; margin-top: 1rem; max-width: 56ch;">
          Not a certificate of attendance — a structured personal development intervention.
        </p>
      </div>

      <div class="cert-outcomes-grid reveal-on-scroll">
        {outcomes.map((o) => (
          <div class="cert-outcome-item">
            <div class="cert-outcome-num">{o.num}</div>
            <p class="cert-outcome-text">{o.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 6. HOW IT WORKS (3 STEPS) ==================== -->
  <section class="section" style="background: #F6F4F2; padding-block: clamp(4.5rem, 8vw, 7rem);">
    <div class="site-shell">
      <div class="cert-steps-grid reveal-on-scroll">
        {steps.map((s) => (
          <div class="cert-step-card">
            <div class="cert-step-label">{s.step}</div>
            <h3 class="cert-step-title">{s.title}</h3>
            <p class="cert-step-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 7. SnS PROGRAM & WHAT IT IS NOT ==================== -->
  <section class="section section--cert-sns">
    <div class="site-shell">
      <div class="split-layout reveal-on-scroll" style="align-items: flex-start; gap: 3.5rem;">
        <div>
          <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
            OUTCOMES
          </div>
          <h2 style="color: #4C4747; font-size: clamp(2.2rem, 4.5vw, 3.8rem); font-weight: 700; line-height: 1.1; margin-top: 0.75rem; max-width: 18ch;">
            A program from SnS Coaching and Consulting Services.
          </h2>
          <p style="font-size: 1.15rem; line-height: 1.65; color: #4C4747; margin-top: 1.5rem; max-width: 48ch;">
            The Executive Certificate is delivered through <a href="https://snsccs.com/" target="_blank" rel="noopener noreferrer" style="color: #0F1E31; font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">SnS Coaching and Consulting Services</a>, and built around the same RAPL™ Leadership Framework published on this site.
          </p>
        </div>

        <div style="background: #ffffff; border-radius: 6px; padding: 2.5rem; border: 1px solid rgba(15, 30, 49, 0.08); box-shadow: 0 6px 24px rgba(15, 30, 49, 0.04); width: 100%;">
          <h3 style="color: #4C4747; font-size: 1.85rem; font-weight: 700; margin: 0 0 1.5rem; line-height: 1.2;">
            What this program is not
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem;">
            {isNotList.map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 0.85rem; font-size: 1.1rem; line-height: 1.5; color: #4C4747; padding-bottom: 1rem; border-bottom: 1px solid rgba(15, 30, 49, 0.08);">
                <span style="color: #781222; font-weight: 700; font-size: 1.2rem; line-height: 1;" aria-hidden="true">✕</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 8. NEXT COHORT CTA BANNER ==================== -->
  <section class="section" id="apply" style="background: #F6F3EA; padding-block: clamp(5rem, 9vw, 8rem); border-top: 1px solid rgba(15, 30, 49, 0.08);">
    <div class="site-shell reveal-on-scroll">
      <div class="eyebrow" style="color: #4C4747; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
        NEXT COHORT
      </div>
      <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.1; max-width: 26ch;">
        Apply for the next Executive Certificate cohort.
      </h2>
      <p style="color: #000000; font-size: 1.25rem; margin-top: 1.5rem; max-width: 58ch; line-height: 1.5;">
        Spaces are limited to preserve cohort depth. The next cohort opens enrollment quarterly.
      </p>
      <div class="button-row" style="margin-top: 2.5rem; gap: 1rem;">
        <a class="button primary" href="/contact?interest=certificate" style="background: #755436; color: #ffffff; border: 1px solid #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          Apply or request a brief→
        </a>
        <a class="button" href="/framework" style="background: transparent; border: 1.5px solid #755436; color: #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          See the framework first
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

