---
import BaseLayout from "../components/BaseLayout.astro";

/* Content sourced from "executive page .docx" (2026-09-24 content review),
   replacing the previous copy transferred from snsccs.com/executive-training.
   Styling/markup patterns kept as-is (RAPL theme). Route intentionally kept
   at /certificate — see PR discussion; docx's stated URL of
   /executive-leadership-training was not adopted to avoid breaking the 8+
   internal links already pointing at /certificate. */

const heroFocus = [
  "Strategic thinking and executive decision-making",
  "Portfolio, program and project governance",
  "Risk, resilience and change leadership",
  "Performance, OKRs and benefits realization",
  "AI-ready, future-focused leadership",
];

const industries = [
  "IT & Technology",
  "Banking & Finance",
  "Healthcare",
  "Construction",
  "Telecom",
  "Manufacturing",
  "Government",
  "Education",
  "Energy & Utilities",
];

const payoffs = [
  "Clear view of operations: see how work, cost and value actually flow through your organization",
  "Better decisions under pressure: apply proven frameworks when data is incomplete",
  "Aligned goals: connect business strategy, OKRs and daily delivery",
  "Stronger portfolios: prioritize the right initiatives and stop funding the wrong ones",
  "Smarter risk management: anticipate uncertainty instead of reacting to it",
  "Governance that works: build oversight that supports speed instead of slowing it down",
  "AI-ready leadership: use automation and analytics to improve performance responsibly",
  "Lasting change: lead adoption so improvements stick",
];

const audiences = [
  {
    title: "Chiefs and C-Suite Executives",
    desc: "When strategy has to become execution across every function, you need a leadership system, not good intentions. This program closes the gap between boardroom decisions and frontline delivery.",
  },
  {
    title: "Directors",
    desc: "You sit where strategy meets operations. Learn to turn direction into plans, manage competing priorities and hold teams accountable without micromanaging.",
  },
  {
    title: "Senior Managers",
    desc: "Preparing for the next level? Build the strategic mindset, influence and executive presence that senior roles demand.",
  },
  {
    title: "Succession and Emerging Leaders",
    desc: "Future executives need more than technical skill. Develop portfolio thinking, decision-making and leadership maturity before you step into the top seat.",
  },
  {
    title: "PMO and Execution Office Leaders",
    desc: "Move your PMO from a reporting function to a strategic partner. Learn to influence at the C-suite table and link delivery to business value.",
  },
  {
    title: "Operations, Transformation and Functional Leaders",
    desc: "Improve efficiency, adoption and customer outcomes while leading people through change.",
  },
];

const learningAreas = [
  { title: "Strategic Leadership", desc: "Set direction, define priorities and make sure every initiative supports the bigger picture." },
  { title: "Executive Decision-Making", desc: "Make confident calls with imperfect information. Weigh risk, trade-offs and long-term impact." },
  { title: "Change and Transformation Leadership", desc: "Guide people through disruption, build buy-in and turn change into a habit, not a crisis." },
  { title: "High-Performance Teams", desc: "Create trust, accountability and momentum across departments and reporting lines." },
  { title: "Governance and Execution", desc: "Put oversight and delivery discipline in place so results are consistent and repeatable." },
  { title: "Communication and Influence", desc: "Speak the language of boards, stakeholders and teams, and inspire action at every level." },
  { title: "Innovation and Growth", desc: "Spot opportunities early, back the right ideas and build a culture of continuous improvement." },
];

const format = [
  { value: "2 Weeks", label: "DURATION", note: "Focused, intensive coaching" },
  { value: "One-to-One", label: "FORMAT", note: "Private, one-to-one sessions" },
  { value: "Fully Tailored", label: "CUSTOMIZATION", note: "Fully tailored to your goals and organization" },
  { value: "$10,000 USD", label: "INVESTMENT", note: "Premium one-to-one program" },
];

const credentials = [
  { code: "PMP®", name: "Project Management Professional" },
  { code: "PgMP®", name: "Program Management Professional" },
  { code: "PfMP®", name: "Portfolio Management Professional" },
  { code: "PMI-CPMAI®", name: "Certified Professional in Managing AI" },
  { code: "PMI-RMP®", name: "Risk Management Professional" },
  { code: "PMI-ACP®", name: "Agile Certified Practitioner" },
  { code: "PMI-PMOCP®", name: "PMO Certified Practitioner" },
  { code: "PMI-PBA®", name: "Professional in Business Analysis" },
];

const artifacts = [
  "Operational value-chain map",
  "Current-state operational analysis",
  "Future-state and AI alignment roadmap",
  "Portfolio prioritization view",
  "Benefits realization map",
  "Initiative delivery brief",
  "Risk, resilience and uncertainty framework",
  "Change and stakeholder adoption plan",
  "Operational transition and value sustainment plan",
  "AI optimization opportunity canvas",
  "Executive office or PMO governance model",
  "Executive certificate of completion",
  "Optional digital badge for professional visibility",
];

const steps = [
  { step: "STEP 1", title: "Consultation", desc: "We learn about your role, challenges and goals." },
  { step: "STEP 2", title: "Program Design", desc: "We build a custom learning roadmap around your needs." },
  { step: "STEP 3", title: "Training Delivery", desc: "Interactive one-to-one coaching, case work and workshops." },
  { step: "STEP 4", title: "Performance Impact", desc: "We track progress and confirm the value delivered." },
];

// Kept as-is per the docx's own note: "(Add your own real, verified
// testimonials here.)" — these are the site's existing real testimonials.
const testimonials = [
  {
    quote: "Samia's coaching helped me bridge project management theory with how work actually happens at Amazon. Her breadth of credentials and real-world experience is unmatched. The one-on-one sessions played a key role in helping me grow.",
    name: "Nyle Hassan",
    role: "Project Manager",
    org: "Amazon",
    result: "Passed - Above Target",
  },
  {
    quote: "I studied project management with Samia over a decade ago and passed PMP on the first attempt. Years later, I returned for one-on-one PgMP coaching. Very few professionals maintain this level of depth and relevance over time.",
    name: "Moeen Khurshid",
    role: "Senior Project Manager",
    org: "Ontario Public Service",
    result: "15% Salary Increase",
  },
  {
    quote: "I completed PMP with Samia five years ago and am now enrolled in CPMAI. Her ability to simplify complex project management frameworks while keeping them practical and relevant has consistently supported my professional growth.",
    name: "Syeda Rabbia",
    role: "Project Manager",
    org: "Ontario Public Service",
    result: "Passed First Attempt",
  },
];

// Hrefs resolved against the live RAPL blog API + existing site pages —
// all six slugs/paths below were verified to exist and be published.
const relatedResources = [
  { title: "The Strategy-Execution Gap", desc: "why strong strategies fail in delivery", href: "/blogs/strategy-execution-gap" },
  { title: "Leadership Capability and AI", desc: "what leaders need in an AI-driven workplace", href: "/blogs/leadership-capability-ai" },
  { title: "Leadership Readiness", desc: "are you prepared for the next leadership level?", href: "/blogs/leadership-readiness" },
  { title: "The RAPL Framework", desc: "the model behind this program", href: "/framework" },
  { title: "Executive Certificate", desc: "what you earn on completion", href: "/certificate#outcomes" },
  { title: "Programs for Organizations", desc: "leadership development for teams", href: "/organizations" },
];

const faqs = [
  {
    q: "Who is this executive leadership program designed for?",
    a: "It is built for C-suite executives, directors, senior managers, PMO leaders and rising leaders who are accountable for strategy, transformation and results.",
  },
  {
    q: "Why is the program delivered one-to-one?",
    a: "One-to-one training focuses entirely on your real challenges. You get more depth, more privacy and faster results than a group class can offer.",
  },
  {
    q: "What does the $10,000 investment include?",
    a: "It covers the full two-week custom program: consultation, tailored design, live coaching, practical tools and templates, and your executive certificate of completion.",
  },
  {
    q: "Is this a group or a private program?",
    a: "Private. Sessions are delivered to you individually and can be tailored for an organization on request.",
  },
  {
    q: "Do I need a project management certification before starting?",
    a: "No. The program draws on recognized frameworks, but no prior certification is required.",
  },
  {
    q: "How long is the program?",
    a: "Two weeks of focused, intensive coaching, scheduled around your availability.",
  },
];

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Executive Leadership Training for C-Suite & Directors",
  description:
    "A private, one-to-one, two-week executive leadership training program for C-suite leaders, directors and PMO heads. Build strategic decision-making, change leadership, governance and execution skills, and finish with an executive certificate of completion.",
  url: "https://www.raplleadership.com/certificate",
  inLanguage: "en",
  educationalLevel: "Executive",
  teaches: [
    "Strategic leadership",
    "Executive decision-making",
    "Change and transformation leadership",
    "High-performance teams",
    "Governance and execution",
    "Communication and influence",
    "Innovation and growth",
  ],
  audience: {
    "@type": "Audience",
    audienceType: "C-suite executives, directors, senior managers, PMO leaders and emerging leaders",
  },
  provider: {
    "@type": "Organization",
    name: "RAPL Leadership",
    url: "https://www.raplleadership.com",
  },
  offers: {
    "@type": "Offer",
    category: "Paid",
    price: "10000",
    priceCurrency: "USD",
    url: "https://www.raplleadership.com/certificate",
    availability: "https://schema.org/InStock",
  },
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    courseWorkload: "P2W",
    instructor: {
      "@type": "Person",
      name: "Samia Waqar",
    },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="Executive Leadership Training for C-Suite & Directors"
  description="Build executive leadership that turns strategy into results. Private, one-to-one 2-week program for C-suite, directors and PMO heads. Book a consult."
  jsonLd={[courseSchema, faqSchema]}
>
  <!-- ==================== 1. HERO ==================== -->
  <section class="page-hero page-hero--certificate">
    <div class="site-shell">
      <div class="cert-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; letter-spacing: 0.08em; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
          EXECUTIVE LEADERSHIP TRAINING
        </div>
        <h1 class="cert-hero-title">
          Executive Leadership Training That Turns <span style="color: #755436;">Strategy Into Measurable Results</span>
        </h1>
        <p class="cert-hero-lede">
          Strong executive leadership is the difference between a great strategy on paper and a great outcome in the market. This private, one-to-one program helps C-suite leaders, directors and PMO heads sharpen decision-making, align teams and deliver change with confidence.
        </p>

        <p style="color: #4C4747; font-size: 1rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; margin: 1.75rem 0 0.75rem;">
          What you will focus on:
        </p>
        <ul class="cert-hero-modules">
          {heroFocus.map((m) => (
            <li class="cert-hero-module">{m}</li>
          ))}
        </ul>

        <p id="enroll-cancelled-notice" class="enroll-cancelled-notice" hidden>
          Checkout was cancelled — no payment was made.
          <button type="button" id="enroll-cancelled-dismiss" aria-label="Dismiss">×</button>
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact?interest=consultation" style="background: #755436; color: #ffffff; border: 1px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Book a Free Consultation
          </a>
          <a class="button" href="/diagnostic" style="background: transparent; color: #102033; border: 1.5px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Take the Leadership Diagnostic
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. INDUSTRIES / ORGANIZATIONS THAT NEED TO DELIVER ==================== -->
  <section class="section" style="background: #F2EEEB; padding-block: clamp(4rem, 7vw, 6.5rem);">
    <div class="site-shell">
      <div style="max-width: 62rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          INDUSTRIES SERVED
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem;">
          Executive Leadership Development for Organizations That Need to Deliver
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.6; margin-top: 1.25rem; max-width: 62ch;">
          Every sector faces the same pressure: deliver more, faster, with less certainty. Executive leadership training gives senior leaders the clarity to respond with a plan instead of a reaction.
        </p>
      </div>

      <ul class="cert-industry-grid reveal-on-scroll">
        {industries.map((i) => (
          <li class="cert-industry-chip">{i}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== 3. ABOUT THE EXECUTIVE LEADERSHIP PROGRAM ==================== -->
  <section class="section" style="background: #FFFFFF; padding-block: clamp(5rem, 8vw, 7.5rem);" id="overview">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          ABOUT THE PROGRAM
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem; max-width: 30ch;">
          About the Executive Leadership Program
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.5rem; max-width: 70ch;">
          Most leadership programs are built for a room full of strangers. This one is built for you.
        </p>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.25rem; max-width: 70ch;">
          The program is delivered one-to-one, so every session focuses on your organization, your priorities and your real decisions. There is no generic theory and no filler. You work on live challenges such as a stalled transformation, an underperforming portfolio, a misaligned team or a strategy that never reaches the front line.
        </p>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.25rem; max-width: 70ch;">
          The approach is role-agnostic. Whether you lead a business unit, a PMO or an entire company, the same principles apply: clear direction, disciplined execution and accountable teams. You finish with practical tools you can use the following Monday, plus an executive certificate of completion.
        </p>
        <div class="button-row" style="margin-top: 2rem;">
          <button type="button" class="button primary" id="enroll-now-btn" style="background: #755436; color: #ffffff; border: 1px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; cursor: pointer;">
            Start Your Journey
          </button>
          <a class="button" href="/contact?interest=consultation" style="background: transparent; color: #102033; border: 1.5px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Request a Free Consultation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 4. WHY EXECUTIVE LEADERSHIP TRAINING PAYS OFF ==================== -->
  <section class="section" style="background: #F2EEEB; padding-block: clamp(5rem, 8vw, 7.5rem);" id="payoff">
    <div class="site-shell">
      <div style="max-width: 62rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          WHY IT PAYS OFF
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          Why Executive Leadership Training Pays Off
        </h2>
      </div>

      <ul class="cert-artifact-list reveal-on-scroll">
        {payoffs.map((p) => (
          <li class="cert-artifact-item">
            <span class="cert-artifact-check" aria-hidden="true">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== 5. WHO IS THIS PROGRAM FOR ==================== -->
  <section class="section" style="background: #FFFFFF; padding-block: clamp(5rem, 8vw, 7.5rem);" id="who">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          WHO IT'S FOR
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem; max-width: 26ch;">
          Who Is This Executive Leadership Program For?
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.25rem; max-width: 70ch;">
          Designed for leaders who own results, not just tasks.
        </p>
      </div>

      <div class="cert-topic-grid reveal-on-scroll">
        {audiences.map((a) => (
          <div class="cert-topic-card">
            <h3 class="cert-topic-title">{a.title}</h3>
            <p class="cert-topic-desc">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 6. CORE EXECUTIVE LEADERSHIP SKILLS ==================== -->
  <section class="section" style="background: #F6F4F2; padding-block: clamp(5rem, 8vw, 7.5rem);" id="learning">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          CORE SKILLS
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem;">
          Core Executive Leadership Skills You Will Build
        </h2>
      </div>

      <div class="cert-topic-grid reveal-on-scroll">
        {learningAreas.map((l) => (
          <div class="cert-topic-card">
            <h3 class="cert-topic-title">{l.title}</h3>
            <p class="cert-topic-desc">{l.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 7. PROGRAM DURATION, FORMAT AND INVESTMENT ==================== -->
  <section class="section section--tight" style="background: #FFFFFF; border-block: 1px solid rgba(15, 30, 49, 0.08); padding-block: 3.5rem;" id="investment">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          DURATION, FORMAT AND INVESTMENT
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          Program Duration, Format and Investment
        </h2>
      </div>

      <div class="cert-stat-grid reveal-on-scroll">
        {format.map((f) => (
          <div class="cert-stat-item">
            <div class="cert-stat-num cert-stat-num--text">{f.value}</div>
            <div class="cert-stat-label">{f.label}</div>
            <p class="cert-stat-desc">{f.note}</p>
          </div>
        ))}
      </div>

      <p class="reveal-on-scroll" style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 2rem; max-width: 70ch;">
        Because the program is private, your confidential challenges, data and strategy stay yours. Schedules flex around your calendar and content adapts to your industry and role.
      </p>
    </div>
  </section>

  <!-- ==================== 8. BUILT ON PMI FRAMEWORKS ==================== -->
  <section class="section" style="background: #FFFFFF; padding-block: clamp(5rem, 8vw, 7.5rem); border-block: 1px solid rgba(15, 30, 49, 0.06);" id="pmi">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          FOUNDATIONS
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem; max-width: 30ch;">
          Built on Globally Recognized Project, Program and Portfolio Frameworks
        </h2>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.5rem; max-width: 70ch;">
          Great executive leadership needs a solid delivery foundation. This program draws on the discipline behind respected project management standards and combines them into one practical leadership approach. Instead of teaching each in isolation, it shows how strategy, portfolio, agile, risk and business analysis connect at the executive level.
        </p>
        <p style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 1.25rem; max-width: 70ch;">
          Knowledge areas covered:
        </p>
      </div>

      <div class="cert-cred-grid reveal-on-scroll">
        {credentials.map((c) => (
          <div class="cert-cred-card">
            <div class="cert-cred-code">{c.code}</div>
            <div class="cert-cred-name">({c.name})</div>
          </div>
        ))}
      </div>

      <p class="reveal-on-scroll" style="color: #4C4747; font-size: 1.2rem; line-height: 1.65; margin-top: 2.5rem; max-width: 70ch;">
        These certifications are not required and are not the goal. They are the knowledge base behind the program.
      </p>
    </div>
  </section>

  <!-- ==================== 9. WHAT YOU WALK AWAY WITH ==================== -->
  <section class="section" style="background: #F2EEEB; padding-block: clamp(5rem, 8vw, 7.5rem);" id="outcomes">
    <div class="site-shell">
      <div style="max-width: 62rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          OUTCOMES
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          What You Walk Away With
        </h2>
      </div>

      <ul class="cert-artifact-list reveal-on-scroll">
        {artifacts.map((a) => (
          <li class="cert-artifact-item">
            <span class="cert-artifact-check" aria-hidden="true">✓</span>
            <span>{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== 10. HOW IT WORKS ==================== -->
  <section class="section" style="background: #F6F4F2; padding-block: clamp(4.5rem, 8vw, 7rem);" id="how">
    <div class="site-shell">
      <div style="max-width: 62rem; margin-bottom: 3rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          HOW IT WORKS
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.1; margin-top: 0.5rem;">
          How the Executive Leadership Program Works
        </h2>
      </div>

      <div class="cert-steps-grid cert-steps-grid--four reveal-on-scroll">
        {steps.map((s) => (
          <div class="cert-step-card">
            <div class="cert-step-label">{s.step}</div>
            <h3 class="cert-step-title">{s.title}</h3>
            <p class="cert-step-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 11. TESTIMONIALS ==================== -->
