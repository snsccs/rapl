---
import BaseLayout from "../components/BaseLayout.astro";

const questions = [
  {
    num: "01",
    title: "Content validity",
    desc: "Are the twelve capabilities of the RAPL™ Framework relevant, clear, sufficiently distinct & complete enough for senior leadership work?",
  },
  {
    num: "02",
    title: "Role demand",
    desc: "What capabilities do different senior seats actually require, and how does that demand vary by context, sector and consequence?",
  },
  {
    num: "03",
    title: "Talent-system alignment",
    desc: "Do leadership and talent systems develop, assess, reward, reinforce and observe the capabilities the roles require the same comparison the Leadership Capability Alignment Diagnostic is built to surface?",
  },
  {
    num: "04",
    title: "Intervention effectiveness",
    desc: "Does deliberate development of the RAPL™ capabilities change executive decisions, sponsorship behavior and value realization in live strategic work?",
  },
];

const propositions = [
  {
    tag: "P1",
    title: "Role–Capability Fit",
    desc: "Leadership seats that align capability development with strategic role demand show stronger decision quality than seats that do not.",
  },
  {
    tag: "P2",
    title: "Sponsorship Discipline",
    desc: "Strong sponsorship discipline is associated with better risk visibility, less normalized escalation and stronger benefits realization.",
  },
  {
    tag: "P3",
    title: "Governance Integration",
    desc: "Capability embedded into governance forums predicts more disciplined investment review than capability developed through training alone.",
  },
  {
    tag: "P4",
    title: "Value Conversion",
    desc: "Organizations that deliberately build & assess relevant leadership capability are hypothesized to show stronger sustained benefits realization from AI & transformation investment than organizations that do not.",
  },
  {
    tag: "P5",
    title: "System Reinforcement",
    desc: "Capability embedded into role design, succession, development, performance and governance — the approach outlined in RAPL™'s organizational application — is hypothesized to be more durable than capability developed through standalone training alone.",
  },
];

const participation = [
  "Expert-panel review of capability relevance and clarity.",
  "Role-demand survey participation.",
  "Talent-system document review and interviews.",
  "Organizational alignment pilot, aligned with the engagement options available through organizational application.",
  "RAPL™ development intervention study, delivered through the Executive Certificate or a targeted organizational cohort.",
  "Academic methods, ethics or publication collaboration.",
];
---

<BaseLayout
  title="Research and Validation | RAPL™ Framework"
  description="RAPL™ is a testable response to the Leadership Capability Gap in AI-enabled work. See our research agenda separating evidence from open questions."
>
  <!-- ==================== 1. HERO SECTION (Figma Node 6188:10242) ==================== -->
  <section class="page-hero page-hero--research">
    <div class="site-shell">
      <div class="research-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; letter-spacing: 0.08em; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
          RESEARCH AND VALIDATION
        </div>
        <h1 class="research-hero-title">
          A testable response to the Leadership Capability Gap.
        </h1>
        <p class="research-hero-lede">
          RAPL™ is offered as a testable response to the <a href="/" style="color: #755436; font-weight: 700; text-decoration: underline; text-underline-offset: 3px;">Leadership Capability Gap</a> identified across strategic, AI-enabled work. The research agenda separates what existing evidence supports from what still requires direct measurement.
        </p>
        <div class="button-row">
          <a class="button primary" href="/contact?interest=research" style="background: #755436; color: #ffffff; border: 1px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Discuss research collaboration→
          </a>
          <a class="button" href="/framework" style="background: transparent; color: #3C3B3B; border: 1.5px solid #3C3B3B; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            See the framework
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. THE EVIDENCE POSITION (Figma Node 6295:10083) ==================== -->
  <section class="section section--evidence-position" id="evidence-position">
    <div class="site-shell">
      <div class="evidence-position-grid reveal-on-scroll">
        <div class="evidence-position-left">
          <div class="eyebrow evidence-position-eyebrow">
            THE EVIDENCE POSITION
          </div>
          <h2 class="evidence-position-title">
            The literature supports the problem. It does not yet establish RAPL&trade; as a fully validated intervention.
          </h2>
        </div>
        <div class="evidence-position-card">
          <p class="evidence-position-text">
            Existing research and professional practice support the changing nature of work, the difficulty of strategy execution, leadership-development transfer problems, benefits-realization gaps, AI scaling barriers, dynamic capability and the increasing relevance of project and transformation capability to senior leadership.
          </p>
          <p class="evidence-position-text">
            They do not yet directly prove the complete RAPL&trade; intervention as validated across roles and organizations. That boundary should remain visible &mdash; and it is precisely what this research agenda is designed to close.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. FOUR VALIDATION QUESTIONS (Figma Node 6297:10105) ==================== -->
  <section class="section section--research-questions" id="questions">
    <div class="site-shell">
      <div class="research-questions-header-card reveal-on-scroll">
        <div class="eyebrow research-questions-eyebrow">
          THE RESEARCH QUESTIONS
        </div>
        <h2 class="research-questions-title">
          Four validation questions.
        </h2>
        <p class="research-questions-lede">
          The research agenda is organized around four questions. Each connects to a method, a sample, &amp; an expected outcome.
        </p>
      </div>

      <div class="research-questions-grid reveal-on-scroll">
        {questions.map((q) => (
          <div class="research-question-card">
            <span class="research-question-num">{q.num}</span>
            <div class="research-question-content">
              <h3 class="research-question-title">{q.title}</h3>
              <p class="research-question-desc">{q.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 4. TESTABLE PROPOSITIONS (Figma Node 6299:10127) ==================== -->
  <section class="section section--research-propositions" id="propositions">
    <div class="site-shell">
      <div class="research-propositions-header reveal-on-scroll">
        <div class="eyebrow research-propositions-eyebrow">
          TESTABLE PROPOSITIONS
        </div>
        <h2 class="research-propositions-title">
          Five propositions the framework proposes.
        </h2>
        <p class="research-propositions-lede">
          The framework is built on a set of explicit, testable claims about how leadership capability shows up in strategic work &mdash; and what changes when it is deliberately developed.
        </p>
      </div>

      <div class="research-propositions-stack reveal-on-scroll">
        {propositions.map((p, i) => (
          <div class={`research-prop-row ${i % 2 === 0 ? "research-prop-row--beige" : "research-prop-row--white"}`}>
            <div class="research-prop-tag">{p.tag}</div>
            <div class="research-prop-title">{p.title}</div>
            <p class="research-prop-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 5. SIX WAYS TO PARTICIPATE (Figma Node 6299:10159) ==================== -->
  <section class="section section--research-participate" id="participate">
    <div class="site-shell">
      <div class="research-participate-grid reveal-on-scroll">
        <div class="research-participate-left">
          <div class="eyebrow research-participate-eyebrow">
            WHAT YOU GET
          </div>
          <h2 class="research-participate-title">
            Six ways to participate.
          </h2>
          <p class="research-participate-lede">
            If your work touches leadership development, senior-team capability, or the evidence base behind AI-enabled transformation, there is likely a structured way to participate.
          </p>
        </div>

        <div class="research-participate-text-list">
          {participation.map((item) => (
            <p class="research-participate-text-item">{item}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 6. METHODOLOGICAL HONESTY (Figma Node 6299:10182) ==================== -->
  <section class="section section--methodological-honesty" id="honesty">
    <div class="site-shell">
      <div class="methodological-honesty-wrap reveal-on-scroll">
        <div class="eyebrow methodological-honesty-eyebrow">
          METHODOLOGICAL HONESTY
        </div>
        <h2 class="methodological-honesty-title">
          The objective is not to defend a framework.
        </h2>
        <p class="methodological-honesty-desc">
          The objective is not to defend the RAPL™ Leadership Framework at all costs. It is to examine the problem, test the model's twelve capabilities &amp; improve both the framework &amp; the intervention when evidence requires it.
        </p>
        <p class="methodological-honesty-desc">
          That is the standard the research agenda holds itself to &mdash; and the standard we ask collaborators, reviewers and pilot organizations to hold it to as well.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== 7. HELP SHAPE THE NEXT STAGE CTA BANNER (Figma Node 6299:10197) ==================== -->
  <section class="section section--research-cta" id="shape-next-stage">
    <div class="site-shell reveal-on-scroll">
      <div class="eyebrow research-cta-eyebrow">
        HELP SHAPE THE NEXT STAGE
      </div>
      <h2 class="research-cta-title">
        Discuss expert review, organizational participation or academic collaboration and help shape the next stage of the RAPL™ Leadership Framework.
      </h2>
      <div class="research-cta-buttons">
        <a class="research-cta-btn-primary" href="/contact?interest=research">
          Start the conversation→
        </a>
        <a class="research-cta-btn-outline" href="/framework">
          See the framework
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

