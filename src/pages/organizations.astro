---
import BaseLayout from "../components/BaseLayout.astro";

const sequence = [
  {
    num: "01",
    title: "Seat profiles and role demand",
    desc: "Define what the work actually requires from each senior seat — CEO, CIO, CHRO, CFO, COO, chief transformation officer, PMO leader and business-unit leaders — and what the consequences of weak capability look like.",
  },
  {
    num: "02",
    title: "Capability baseline",
    desc: "Assess current leadership capability against the twelve RAPL™ capabilities, using structured interviews, decision journals and evidence-based evaluation rather than self-report alone.",
  },
  {
    num: "03",
    title: "Gap heatmap and prioritization",
    desc: "Surface the gap between role demand and current capability as a visible heatmap — by seat, by phase, by capability — so that development investment is targeted where it matters most.",
  },
  {
    num: "04",
    title: "Targeted development",
    desc: "Build a development path for each seat and cohort, drawing on the Executive Certificate, targeted modules, executive coaching and applied work in live strategic initiatives.",
  },
  {
    num: "05",
    title: "Governance and talent-system integration",
    desc: "Embed RAPL™ into role design, performance standards, succession criteria, executive governance forums and investment review — so the capability is reinforced by the system, not just training.",
  },
];

const delivery = [
  {
    title: "Executive cohort programs",
    desc: "Group development for senior leadership cohorts, built around the twelve RAPL™ capabilities.",
  },
  {
    title: "Capability baseline and heatmap",
    desc: "A diagnostic engagement surfacing the gap between role demand and current leadership capability.",
  },
  {
    title: "Governance integration",
    desc: "Embedding RAPL™ into investment review, sponsorship, performance and succession systems.",
  },
  {
    title: "Organization-wide rollout",
    desc: "Multi-year capability development for entire leadership populations, with measurement against role demand.",
  },
];

const integration = [
  "Role profiles tied to capability demand",
  "Performance standards referencing RAPL™ capabilities",
  "Succession criteria grounded in the framework",
  "Investment review with capability lens",
  "Governance forums with sponsorship discipline",
  "Cohort development aligned with strategy",
];
---

<BaseLayout
  title="For Organizations | RAPL™ Leadership at Scale"
  description="Scale RAPL™ across your organization to shape role design, governance forums, performance standards & succession criteria not just individuals."
>
  <!-- ==================== 1. HERO SECTION (Figma Node 6182:10126) ==================== -->
  <section class="page-hero page-hero--organizations">
    <div class="site-shell">
      <div class="org-hero-copy reveal-on-scroll">
        <div class="eyebrow" style="color: #755436; font-size: 1.25rem; letter-spacing: 0.08em; font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem;">
          FOR ORGANIZATIONS
        </div>
        <h1 class="org-hero-title">
          RAPL™ at organizational scale: from individual capability to leadership system.
        </h1>
        <p class="org-hero-lede">
          RAPL™ is most effective when it shapes role design, governance forums, performance standards and succession criteria across the leadership system — not just individual development.
        </p>
        <div class="button-row">
          <a class="button primary" href="/assessment" style="background: #755436; color: #ffffff; border: 1px solid #755436; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            Run the Alignment Diagnostic→
          </a>
          <a class="button" href="/framework" style="background: transparent; color: #3C3B3B; border: 1.5px solid #8C725A; border-radius: 4px; font-size: 0.95rem; font-weight: 700; padding: 0.7rem 1.5rem; text-decoration: none;">
            See the framework
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 2. IMPLEMENTATION SEQUENCE ==================== -->
  <section class="section section--org-sequence">
    <img src="/org_sequence_skyline.png" alt="" class="org-sequence-skyline" aria-hidden="true" />
    <div class="site-shell">
      <div class="org-sequence-header reveal-on-scroll">
        <div class="eyebrow org-sequence-eyebrow">
          IMPLEMENTATION SEQUENCE
        </div>
        <h2 class="org-sequence-title">
          A structured path from baseline to system integration.
        </h2>
        <p class="org-sequence-lede">
          RAPL™ organizational engagements move through five stages — from defining what the work demands, to embedding the capability into the system that develops and rewards leaders.
        </p>
      </div>

      <div class="org-sequence-stack reveal-on-scroll">
        {sequence.map((s) => (
          <div class="org-stage-card">
            <div class="org-stage-num">{s.num}</div>
            <div class="org-stage-content">
              <h3 class="org-stage-title">{s.title}</h3>
              <p class="org-stage-desc">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 3. ENGAGEMENT MODELS ==================== -->
  <section class="section" style="background: #FFFFFF; padding-block: clamp(4.5rem, 8vw, 7rem);">
    <div class="site-shell">
      <div style="max-width: 68rem;" class="reveal-on-scroll">
        <div class="eyebrow" style="color: #8C725A; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
          ENGAGEMENT MODELS
        </div>
        <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.25rem); font-weight: 700; line-height: 1.08; margin-top: 0.5rem; max-width: 26ch;">
          Four ways to commission RAPL™ for your organization.
        </h2>
        <p style="color: #000000; font-size: 1.2rem; line-height: 1.6; margin-top: 1.25rem; max-width: 58ch;">
          RAPL™ engagements can be commissioned as discrete diagnostic work, targeted cohort development, governance integration, or full multi-year rollouts.
        </p>
      </div>

      <div class="org-engagement-grid reveal-on-scroll">
        {delivery.map((d) => (
          <div class="org-engagement-card">
            <h3 class="org-engagement-title">{d.title}</h3>
            <p class="org-engagement-desc">{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 4. SYSTEM REINFORCEMENT ==================== -->
  <section class="section section--org-reinforcement">
    <div class="site-shell">
      <div class="split-layout reveal-on-scroll" style="align-items: flex-start; gap: 4rem;">
        <div>
          <div class="eyebrow" style="color: #8C725A; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
            SYSTEM REINFORCEMENT
          </div>
          <h2 style="color: #4C4747; font-size: clamp(2.2rem, 4.5vw, 3.6rem); font-weight: 700; line-height: 1.15; margin-top: 0.75rem; max-width: 18ch;">
            Capability embedded into role design, succession, performance &amp; governance is more durable than standalone training.
          </h2>
        </div>

        <!-- Figma places this copy directly on the section image (a near-flat
             #EAE5E1 interior), with no plate behind it — so no background here. -->
        <div style="padding: 2.5rem; width: 100%;">
          <p style="font-size: 1.15rem; line-height: 1.65; color: #000000;">
            The proposition is straightforward: leadership capability is more likely to change decisions and behavior when the system that defines, develops, assesses, rewards and refreshes it points in the same direction.
          </p>
          <p style="font-size: 1.15rem; line-height: 1.65; color: #000000; margin-top: 1rem;">
            RAPL™ organizational engagements are designed to move beyond training alone — to influence the role profiles, governance forums, performance standards and succession criteria that shape what leaders actually do.
          </p>
          <div class="org-reinforce-grid">
            {integration.map((item) => (
              <div class="org-reinforce-item">
                <div class="org-reinforce-bullet"></div>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 5. RESEARCH AND VALIDATION BAND (Figma node 6276:10171) ==================== -->
  <section class="section section--org-research" id="research-validation">
    <div class="site-shell">
      <div class="org-research-band reveal-on-scroll">
        <div class="org-research-copy">
          <div class="eyebrow org-research-eyebrow">RESEARCH AND VALIDATION</div>
          <p class="org-research-text">
            The RAPL™ research agenda explicitly tests whether capability embedded into
            role design and governance is more durable than standalone training. Read
            proposition P5 in the research page.
          </p>
        </div>
        <a class="org-research-btn" href="/research#evidence-position">
          Read the evidence position→
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== 6. NEXT COHORT / CTA BANNER ==================== -->
  <section class="section" id="commission" style="background: #F6F3EA; padding-block: clamp(5rem, 9vw, 8rem); border-top: 1px solid rgba(15, 30, 49, 0.08);">
    <div class="site-shell reveal-on-scroll">
      <div class="eyebrow" style="color: #4C4747; font-size: 1.25rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1rem;">
        NEXT COHORT
      </div>
      <h2 style="color: #4C4747; font-size: clamp(2.4rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.1; max-width: 26ch;">
        Run the diagnostic, scope a cohort, or start a multi-year rollout.
      </h2>
      <p style="color: #000000; font-size: 1.25rem; margin-top: 1.5rem; max-width: 58ch; line-height: 1.5;">
        Engagements are scoped against the strategic work, the seats involved, and the system we need to influence.
      </p>
      <div class="button-row" style="margin-top: 2.5rem; gap: 1rem;">
        <a class="button primary" href="/assessment" style="background: #755436; color: #ffffff; border: 1px solid #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          Start the Alignment Diagnostic→
        </a>
        <a class="button" href="/contact?interest=organizations" style="background: transparent; border: 1.5px solid #755436; color: #755436; font-weight: 700; border-radius: 7px; padding: 0.75rem 1.75rem; text-decoration: none;">
          Contact RAPL™ Leadership
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

